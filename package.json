{
  "name": "asknycdata",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "data:payroll": "node scripts/refresh-payroll-data.mjs",
    "audit:violations": "node scripts/audit-violation-mapping.mjs",
    "deploy": "npm test && astro check && node scripts/check-snapshots.mjs --warn-only && astro build && wrangler deploy",
    "test": "node --test \"tests/**/*.test.js\"",
    "data:water-sites": "node scripts/refresh-water-sites.mjs",
    "data:school-locations": "node scripts/refresh-school-locations.mjs",
    "data:nyc-outline": "node scripts/refresh-nyc-outline.mjs",
    "data:crashes": "node --env-file-if-exists=.dev.vars scripts/ingest-crashes.mjs",
    "data:crashes:push": "node scripts/ingest-crashes.mjs --push",
    "data:check": "node scripts/check-snapshots.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.154.0"
  }
}

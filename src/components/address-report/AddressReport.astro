---
/*
 * The address report: an address (with suggestions), a ZIP or "Use my
 * location". Once there's a spot the search folds away behind "Change
 * address", and the report shows the place, an "At a glance" line per topic,
 * then the topics in three groups (right now, your block, around you). Each
 * topic loads on its own from its dashboard's API and links to it with the
 * same spot. What each shows is decided in src/lib/address-report/report.js;
 * its wording and HTML in render.js.
 *
 * The spot is in the URL (?lat=&lon=, about a block); the typed address
 * isn't. The landing page's box hands over the typed text as #q=… (a hash
 * never reaches the server) or, without JavaScript, ?q=….
 */
import { MAX_INPUT_LENGTH } from '../../lib/complaints311/location-input.js';

interface Props {
  // Active water sampling stations: { site, place, borough, lat, lon }.
  stations: { site: string; place: string; borough: string | null; lat: number; lon: number }[];
  waterError: boolean;
}
const { stations, waterError } = Astro.props;

// Topics in the order a resident asks about them: what affects today, then
// the block itself, then what's around. Each has a line in "At a glance".
const ICONS: Record<string, string> = {
  water: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>',
  closures: '<path d="M3 10h18v5H3zM6 15v5M18 15v5M7 10l3 5M12 10l3 5"/>',
  complaints: '<path d="M4 5h16v11H9l-5 4z"/>',
  restaurants: '<path d="M7 3v8M5 3v5a2 2 0 0 0 4 0V3M7 11v10M17 3c-2 2-3 5-3 8h3v10"/>',
  help: '<path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/>',
  schools: '<path d="M2 9l10-5 10 5-10 5zM6 11v5c3 2.5 9 2.5 12 0v-5"/>'
};
const GROUPS = [
  { key: 'now', title: 'Right now', intro: 'What could change your day.', topics: [
    { key: 'water', title: 'Drinking water', glance: 'Water', link: 'See the full results' },
    { key: 'closures', title: 'Street closures', glance: 'Streets', link: 'See every closure nearby' }
  ] },
  { key: 'block', title: 'Your block', intro: 'What neighbors call 311 about, within about a 5-minute walk.', topics: [
    { key: 'complaints', title: '311 requests', glance: '311', link: 'See all 311 requests here' }
  ] },
  { key: 'around', title: 'Around you', intro: 'Places nearby, when you need them.', topics: [
    { key: 'restaurants', title: 'Restaurant grades', glance: 'Restaurants', link: 'See every restaurant near here' },
    { key: 'help', title: 'Nearest help', glance: 'Help', link: 'See all help nearby' },
    { key: 'schools', title: 'Nearest public schools', glance: 'Schools', link: 'See schools near here on a map' }
  ] }
];
const TOPICS = GROUPS.flatMap((g) => g.topics);
---

<div class="ar" data-report data-stations={JSON.stringify(stations)} data-water-error={waterError ? '1' : undefined}>
  <section class="dash-section hn-find" id="find" aria-labelledby="ar-find-title">
    <h2 class="sr-only" id="ar-find-title">Search</h2>
    <form class="hn-search" data-form novalidate role="search" aria-label="Get the report for an address">
      <label class="filter-label" for="ar-address">Your address or ZIP code</label>
      <div class="hn-search-row">
        <div class="c311-combo hn-field">
          <input class="search-input" id="ar-address" name="q" type="text" role="combobox" aria-autocomplete="list"
            aria-expanded="false" aria-controls="ar-address-list" autocomplete="street-address" spellcheck="false"
            maxlength={MAX_INPUT_LENGTH} placeholder="Try “350 5th Ave, Manhattan” or “11211”" data-address />
          <ul class="c311-suggest" id="ar-address-list" role="listbox" aria-label="Address suggestions" hidden data-address-list></ul>
        </div>
        <button type="submit" class="c311-go">Get the report</button>
        <button type="button" class="near-btn" data-locate-me>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>
          Use my location
        </button>
      </div>
    </form>
    <div class="scl-suggest-chips" data-address-choices hidden></div>
    <p class="rest-status" role="status" aria-live="polite" data-status></p>
  </section>

  <section class="ar-results" id="report" aria-labelledby="ar-report-title" data-results hidden>
    <header class="ar-head">
      <div class="ar-head-text">
        <h2 class="ar-place" id="ar-report-title" tabindex="-1" data-place>The spot in this link</h2>
        <p class="ar-scope">Within about a 5-minute walk, unless a section says otherwise.</p>
      </div>
      <div class="ar-actions">
        <button type="button" class="near-btn" data-change>Change address</button>
        <button type="button" class="near-btn" data-copy>Copy link</button>
      </div>
    </header>

    <nav class="ar-glance" aria-labelledby="ar-glance-title">
      <h3 class="ar-glance-title" id="ar-glance-title">At a glance</h3>
      <ul class="ar-glance-list">
        {TOPICS.map((t) => (
          <li>
            <a class="ar-glance-item" href={`#ar-${t.key}`} data-glance={t.key} data-tone="loading">
              <span class="ar-glance-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[t.key]} /></span>
              <span class="ar-glance-words">
                <span class="ar-glance-topic">{t.glance}</span>
                <span class="ar-glance-text" data-glance-text>Checking…</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {GROUPS.map((g) => (
      <section class="ar-group" data-group={g.key} aria-labelledby={`ar-group-${g.key}`}>
        <header class="ar-group-head">
          <h3 class="ar-group-title" id={`ar-group-${g.key}`}>{g.title}</h3>
          <p class="ar-group-intro">{g.intro}</p>
        </header>
        <div class="ar-cards">
          {g.topics.map((t) => (
            <article class="ar-card" id={`ar-${t.key}`} tabindex="-1" data-card={t.key} aria-labelledby={`ar-${t.key}-title`} aria-busy="true">
              <h4 class="ar-card-title" id={`ar-${t.key}-title`}>
                <span class="ar-card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[t.key]} /></span>
                {t.title}
              </h4>
              <div class="ar-body" data-body></div>
              <a class="ar-more" data-link href="#">{t.link} <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </section>
    ))}
  </section>
</div>

<script>
  import { spotFromParams, spotToParams, dashboardLinks, complaintsCard, complaintsStandouts, closuresCard, helpCard, nearestStation, restaurantsCard, nearestSchools } from '../../lib/address-report/report.js';
  import {
    waterHtml, waterGlance, complaintsHtml, complaintsGlance, standoutsHtml, closuresHtml, closuresGlance,
    helpHtml, helpGlance, schoolsHtml, schoolsGlance, restaurantsHtml, restaurantsGlance, escape
  } from '../../lib/address-report/render.js';
  import { nearSearch, addressOutcome } from '../../lib/location/near-search.js';
  import { parseLocationInput, isNycZip } from '../../lib/complaints311/location-input.js';
  import { inCityLimits } from '../../lib/in-city.js';
  import { resolveLocation, suggest } from '../../lib/complaints311/geocode.js';
  import zipFile from '../../data/zip-centroids.json';

  const ERROR_TEXT = 'Couldn’t reach NYC Open Data. Their servers might be stuck behind a double-parked truck. Try again in a minute.';
  const TIMEOUT_TEXT = 'NYC Open Data is taking too long to answer. Try again in a minute.';
  const TIMEOUT_MS = 15000;
  // The city's 311 numbers are built once a day; the first request after a deploy waits about a minute.
  const BASELINE_TIMEOUT_MS = 90000;

  const root = document.querySelector<HTMLElement>('[data-report]')!;
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const form = $<HTMLFormElement>('[data-form]');
  const input = $<HTMLInputElement>('[data-address]');
  const list = $<HTMLUListElement>('[data-address-list]');
  const choices = $('[data-address-choices]');
  const locateBtn = $<HTMLButtonElement>('[data-locate-me]');
  const status = $('[data-status]');
  const find = $('#find');
  const results = $('[data-results]');
  const placeEl = $('[data-place]');
  const copyBtn = $<HTMLButtonElement>('[data-copy]');
  const stations = JSON.parse(root.dataset.stations!);
  const waterError = root.dataset.waterError === '1';

  // The spot's name: never in the URL, so a shared or reloaded link says "the spot in this link".
  let placeLabel = (history.state?.placeLabel as string) || '';
  let run = 0; // bumped by every report, so a slow card can't fill in an older one
  let reportAbort = new AbortController(); // cancels the last report's requests when a new one starts
  let shown = ''; // the spot on screen, "lat,lon"
  let lookup = 0; // bumped by every search, so only the latest address lookup counts

  // ---------- The report ----------

  // Gives up after `ms`, or when the report it's for is replaced (signal).
  async function getJson(url: string, signal: AbortSignal, ms = TIMEOUT_MS) {
    const ctl = new AbortController();
    let timedOut = false;
    const timer = setTimeout(() => { timedOut = true; ctl.abort(); }, ms);
    const cancel = () => ctl.abort();
    signal.addEventListener('abort', cancel);
    try {
      const res = await fetch(url, { signal: ctl.signal });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data || data.error) throw new Error(data?.error || ERROR_TEXT);
      return data;
    } catch (err: any) {
      throw timedOut ? new Error(TIMEOUT_TEXT) : err;
    } finally {
      clearTimeout(timer);
      signal.removeEventListener('abort', cancel);
    }
  }

  type Glance = { tone: string; text: string };

  function setGlance(key: string, g: Glance) {
    const el = root.querySelector<HTMLElement>(`[data-glance="${key}"]`)!;
    el.dataset.tone = g.tone;
    el.querySelector('[data-glance-text]')!.textContent = g.text;
  }

  type Loaded = { html: string; glance: Glance };

  /*
   * Each card loads on its own: a slow one doesn't hold up the rest. `after`
   * runs once the body is drawn (311's comparison with the city). A failed
   * card offers "Try again", which loads it (and `after`) again.
   */
  function card(key: string, href: string, load: () => Promise<Loaded>, id: number, after?: () => void) {
    const el = root.querySelector<HTMLElement>(`[data-card="${key}"]`)!;
    const body = el.querySelector<HTMLElement>('[data-body]')!;
    el.querySelector<HTMLAnchorElement>('[data-link]')!.href = href;
    el.setAttribute('aria-busy', 'true');
    body.innerHTML = '<span class="sk-line"></span><span class="sk-line sk-short"></span><span class="sk-line"></span>';
    setGlance(key, { tone: 'loading', text: 'Checking…' });
    load().then(
      ({ html, glance }) => {
        if (id !== run) return;
        body.innerHTML = html;
        setGlance(key, glance);
        after?.();
      },
      (err) => {
        if (id !== run || err?.name === 'AbortError') return;
        body.innerHTML = `<p class="ar-error">${escape(err?.message || ERROR_TEXT)}</p>` +
          (err?.final ? '' : '<button type="button" class="near-btn ar-retry" data-retry>Try again</button>');
        body.querySelector('[data-retry]')?.addEventListener('click', () => {
          card(key, href, load, id, after);
          el.focus({ preventScroll: true });
        });
        setGlance(key, { tone: 'none', text: 'Couldn’t load this' });
      }
    ).finally(() => { if (id === run) el.removeAttribute('aria-busy'); });
  }

  function report(spot: { lat: number; lon: number }) {
    const id = ++run;
    reportAbort.abort();
    reportAbort = new AbortController();
    const signal = reportAbort.signal;
    const get = (url: string, ms?: number) => getJson(url, signal, ms);
    shown = `${spot.lat},${spot.lon}`;
    const at = `lat=${spot.lat}&lon=${spot.lon}`;
    const station = nearestStation(stations, spot);
    const links = dashboardLinks(spot, { waterSite: station?.site });
    // A heading on its own: "your location" → "Your location".
    placeEl.textContent = placeLabel ? placeLabel[0].toUpperCase() + placeLabel.slice(1) : 'The spot in this link';
    find.hidden = true;
    results.hidden = false;

    card('water', links.water, async () => {
      if (waterError) throw Object.assign(new Error('Drinking water results aren’t available right now. Try again later.'), { final: true });
      const data = station ? await get(`/api/water/stations?sites=${encodeURIComponent(station.site)}`) : null;
      return { html: waterHtml(station, data), glance: waterGlance(station, data) };
    }, id);
    card('closures', links.closures, async () => {
      const c = closuresCard(await get(`/api/street-closures/search?${at}&r=0.25`));
      return { html: closuresHtml(c), glance: closuresGlance(c) };
    }, id);

    // 311 draws first; the comparison with the city fills in when its numbers arrive.
    let area: any = null;
    const city = get('/api/311/baseline?window=12m', BASELINE_TIMEOUT_MS);
    city.catch(() => {}); // handled in compare(); a failed area load never gets there
    const compare = () => city.then(
      (b) => {
        const slot = root.querySelector('[data-standouts]');
        if (id !== run || !slot) return;
        const s = complaintsStandouts(area, b.city);
        slot.innerHTML = standoutsHtml(s);
        setGlance('complaints', complaintsGlance(complaintsCard(area), s));
      },
      (err) => {
        const slot = root.querySelector('[data-standouts]');
        if (id === run && slot && err?.name !== 'AbortError') slot.innerHTML = standoutsHtml(null);
      }
    );
    card('complaints', links.complaints, async () => {
      area = await get(`/api/311/area?${at}&area=immediate&window=12m`);
      const c = complaintsCard(area);
      return { html: complaintsHtml(c), glance: complaintsGlance(c) };
    }, id, compare);

    card('restaurants', links.restaurants, async () => {
      const c = restaurantsCard(await get(`/api/restaurants/search?lat=${spot.lat}&lng=${spot.lon}`));
      return { html: restaurantsHtml(c), glance: restaurantsGlance(c) };
    }, id);
    card('help', links.help, async () => {
      const sites = helpCard((await get(`/api/help-near-me/search?${at}`)).sites);
      return { html: helpHtml(sites), glance: helpGlance(sites) };
    }, id);
    card('schools', links.schools, async () => {
      const schools = nearestSchools((await get('/api/schools/search?view=map')).points, spot);
      return { html: schoolsHtml(schools), glance: schoolsGlance(schools) };
    }, id);
  }

  // "At a glance" scrolls to its section without touching the URL: a #hash
  // would add a history entry with no state, and Back/Forward redraw the report.
  root.querySelector('.ar-glance')!.addEventListener('click', (e: Event) => {
    if (!(e instanceof MouseEvent)) return;
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-glance]');
    if (!link || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    const target = document.getElementById(`ar-${link.dataset.glance}`)!;
    const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    target.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
    target.focus({ preventScroll: true });
  });

  function showSearch() {
    find.hidden = false;
    input.focus();
    input.select();
  }

  $('[data-change]').addEventListener('click', showSearch);

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.href);
      copyBtn.textContent = 'Link copied';
    } catch {
      copyBtn.textContent = 'Copy it from the address bar';
    }
    setTimeout(() => { copyBtn.textContent = 'Copy link'; }, 2500);
  });

  function useSpot(lat: number, lon: number, label: string) {
    ++lookup;
    closeOptions();
    choices.hidden = true;
    status.textContent = '';
    placeLabel = label;
    const params = spotToParams({ lat, lon });
    history.pushState({ placeLabel, text: input.value }, '', `${location.pathname}?${params}`);
    report(spotFromParams(params)!);
    document.getElementById('ar-report-title')!.focus({ preventScroll: true });
    results.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  window.addEventListener('popstate', () => {
    const spot = spotFromParams(new URLSearchParams(location.search));
    // Same spot (a #hash someone typed or kept from an old link): leave the report as it is.
    if (spot && `${spot.lat},${spot.lon}` === shown) return;
    placeLabel = history.state?.placeLabel || '';
    input.value = history.state?.text || '';
    if (spot) report(spot);
    else { ++run; reportAbort.abort(); shown = ''; results.hidden = true; find.hidden = false; }
  });

  // ---------- Address box with suggestions ----------

  type Option = { label: string; hint?: string; lat: number; lon: number };
  let options: Option[] = [];
  let active = -1;
  let timer = 0;
  let suggestAbort: AbortController | null = null;

  function renderOptions(next: Option[]) {
    options = next;
    active = -1;
    list.innerHTML = next.map((o, i) =>
      `<li role="option" id="ar-opt-${i}" aria-selected="false" class="c311-option" data-i="${i}">` +
      `<span>${escape(o.label)}</span>${o.hint ? `<span class="c311-option-hint">${escape(o.hint)}</span>` : ''}</li>`).join('');
    list.hidden = !next.length;
    input.setAttribute('aria-expanded', String(next.length > 0));
    input.removeAttribute('aria-activedescendant');
  }
  const closeOptions = () => { clearTimeout(timer); suggestAbort?.abort(); renderOptions([]); };

  function highlightOption(i: number) {
    active = i;
    list.querySelectorAll('[role="option"]').forEach((el, j) => el.setAttribute('aria-selected', String(j === i)));
    if (i >= 0) {
      input.setAttribute('aria-activedescendant', `ar-opt-${i}`);
      list.children[i]?.scrollIntoView({ block: 'nearest' });
    } else input.removeAttribute('aria-activedescendant');
  }

  // A ZIP comes from the text itself; GeoSearch adds addresses.
  async function updateSuggestions() {
    const text = input.value.trim();
    suggestAbort?.abort();
    const local: Option[] = [];
    const c = (zipFile.zips as Record<string, number[]>)[text];
    if (/^\d{5}$/.test(text) && isNycZip(text) && c) local.push({ label: `ZIP code ${text}`, hint: 'The middle of the ZIP', lat: c[0], lon: c[1] });
    if (text.length < 3 || /^\d+$/.test(text)) { renderOptions(local); return; }
    suggestAbort = new AbortController();
    try {
      const places = await suggest(text, { signal: suggestAbort.signal });
      renderOptions([...local, ...places.map((p: any) => ({ label: p.label, lat: p.lat, lon: p.lon }))].slice(0, 6));
    } catch (err: any) {
      if (err.name !== 'AbortError') renderOptions(local); // typing still works; submitting looks it up
    }
  }

  input.addEventListener('input', () => {
    clearTimeout(timer);
    status.textContent = '';
    timer = window.setTimeout(updateSuggestions, 250);
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' && options.length) { e.preventDefault(); highlightOption(Math.min(active + 1, options.length - 1)); }
    else if (e.key === 'ArrowUp' && options.length) { e.preventDefault(); highlightOption(Math.max(active - 1, -1)); }
    else if (e.key === 'Enter' && active >= 0) { e.preventDefault(); pickOption(options[active]); }
    else if (e.key === 'Escape' && options.length) { e.preventDefault(); closeOptions(); }
  });
  // mousedown so the input keeps focus (a click would blur it first and close the list).
  list.addEventListener('mousedown', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
    if (!li) return;
    e.preventDefault();
    pickOption(options[Number(li.dataset.i)]);
  });
  input.addEventListener('blur', () => setTimeout(closeOptions, 150));

  function pickOption(o: Option) {
    input.value = o.label;
    useSpot(o.lat, o.lon, o.label.startsWith('ZIP code') ? `the middle of ${o.label.replace('ZIP code', 'ZIP')}` : o.label);
  }

  // ---------- Search ----------

  async function search() {
    closeOptions();
    choices.hidden = true;
    const parsed: any = parseLocationInput({ text: input.value });
    const next: any = nearSearch(parsed, zipFile.zips);
    if (next.kind === 'message') { status.textContent = next.text; if (next.focus) input.focus(); return; }
    if (next.kind === 'borough') { status.textContent = 'A whole borough is too big for one report. Type an address or ZIP code in it.'; return; }
    if (next.kind === 'point') { useSpot(next.lat, next.lon, next.label); return; }
    status.textContent = 'Looking up that address…';
    const id = ++lookup;
    let result: any;
    try {
      result = addressOutcome(await resolveLocation(parsed));
    } catch {
      if (id === lookup) status.textContent = 'Couldn’t reach the address lookup. Try again in a minute, or use your location.';
      return;
    }
    if (id !== lookup) return;
    if (result.kind === 'point') { useSpot(result.lat, result.lon, result.label); return; }
    status.textContent = result.text;
    if (result.kind === 'choose') {
      choices.innerHTML = result.choices.map((p: any, i: number) =>
        `<button type="button" class="pay-chip" data-pick="${i}">${escape(p.label)}</button>`).join('');
      choices.hidden = false;
      choices.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => b.addEventListener('click', () => {
        const p = result.choices[Number(b.dataset.pick)];
        input.value = p.label;
        useSpot(p.lat, p.lon, p.label);
      }));
    }
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); search(); });

  locateBtn.addEventListener('click', () => {
    choices.hidden = true;
    if (!navigator.geolocation) { status.textContent = 'Your browser can’t share its location. Type an address or ZIP code instead.'; return; }
    const id = ++lookup;
    locateBtn.disabled = true;
    status.textContent = 'Finding you…';
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        locateBtn.disabled = false;
        if (id !== lookup) return;
        const { latitude: lat, longitude: lon } = pos.coords;
        if (!inCityLimits(lat, lon)) { status.textContent = 'You seem to be outside NYC. Type an address or ZIP code instead.'; return; }
        input.value = '';
        useSpot(lat, lon, 'your location');
      },
      () => {
        locateBtn.disabled = false;
        if (id === lookup) status.textContent = 'We couldn’t get your location. Check your browser’s location setting, or type an address or ZIP code.';
      },
      { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 }
    );
  });

  // ---------- Start ----------

  // From the landing page: the typed text, looked up here, then dropped from the URL.
  const params = new URLSearchParams(location.search);
  const handed = new URLSearchParams(location.hash.slice(1)).get('q') ?? params.get('q');
  const spot = spotFromParams(params);
  if (handed) {
    history.replaceState(null, '', location.pathname);
    input.value = handed.slice(0, input.maxLength);
    search();
  } else if (spot) {
    input.value = history.state?.text || '';
    report(spot);
  }
</script>

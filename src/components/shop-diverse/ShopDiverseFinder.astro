---
/*
 * The Shop Diverse NYC finder, for contractors and agency buyers: a filter
 * panel above the results (certification, scope of work, capacity,
 * location), summary chips, ranked result cards, the business detail panel
 * and a shortlist to download as CSV.
 *
 * The first view is rendered here on the server from the URL's query (see
 * src/lib/shop-diverse/filter.js for the parameters), so shared links and the
 * form work without script. The script then fetches /api/shop-diverse/search
 * for every change and keeps the URL in step; a card opens
 * /api/shop-diverse/business/:id in a <dialog> (side panel on wide screens,
 * full-screen sheet on phones) and adds ?biz=<id> to the URL. A shared ?biz=
 * link arrives with that panel rendered here, shown without script by the
 * <noscript> style and opened as a modal by the script.
 *
 * The shortlist lives in the visitor's browser (localStorage, page-state.js)
 * and needs the script, so its buttons and bar show only once it runs
 * (.has-shortlist). Its CSV comes from /api/shop-diverse/export?ids=.
 */
import { CERTS, SORTS, MAX_KEYWORD_LENGTH } from '../../lib/shop-diverse/config.js';
import { queryToParams } from '../../lib/shop-diverse/filter.js';
import { pageUrl, activeFilters, searchExportUrl } from '../../lib/shop-diverse/page-state.js';
import { POINTS } from '../../lib/shop-diverse/ranking.js';
import {
  kpisHtml, cardsHtml, pagerHtml, statusText, categoryOptionsHtml, boroughOptionsHtml, amountOptionsHtml,
  ethnicityChipsHtml, activeFiltersHtml, detailHtml, zipHint, showResultsLabel, UPSTREAM_TEXT, ZIP_ERROR, CODE_ERROR,
  NOT_FOUND_TEXT, DETAIL_LABEL
} from '../../lib/shop-diverse/render.js';
import { codesValid } from '../../lib/shop-diverse/filter.js';
import { MAX_EXPORT } from '../../lib/shop-diverse/config.js';
import { count } from '../../lib/format.js';

interface Props {
  query: any;          // normalizeQuery() result
  initial: any;        // searchBusinesses() result, or null if the data couldn't load
  inputError: string | null;
  business: any;       // the ?biz= business's detail, { missing: true }, or null
}
const { query, initial, inputError, business } = Astro.props;

const base = '/shop-diverse/';
const hrefWith = (extra: Record<string, string>) => {
  const p = queryToParams(query);
  for (const [k, v] of Object.entries(extra)) p.set(k, v);
  return `${base}?${p}`;
};
const pageHref = (page: number) => {
  const p = queryToParams({ ...query, page });
  return p.toString() ? `${base}?${p}` : base;
};
const facets = initial?.facets;
const who = (c: string) => query.who.includes(c);
const status = inputError ?? (initial ? statusText(initial) : UPSTREAM_TEXT);
// normalizeQuery() drops a malformed ZIP (and any ZIP outside the
// Recommended order); keep what was typed, and say so if it's malformed.
const rawZip = Astro.url.searchParams.get('zip')?.trim() ?? '';
const zipInvalid = Boolean(rawZip) && !/^\d{5}$/.test(rawZip);
// The same for codes: normalizeQuery() keeps only the parts that are codes.
const rawCode = Astro.url.searchParams.get('code')?.trim() ?? '';
const codeInvalid = !codesValid(rawCode);
const listHref = pageHref(query.page);
const showResultsText = initial ? showResultsLabel(initial.total) : 'Show results';
const detail = business && !business.missing ? business : null;
const chips = activeFilters(query);
// Safe inside <script type="application/json">
const initialJson = JSON.stringify({ query, loaded: Boolean(initial), business: detail }).replace(/</g, '\\u003c');
---

<section class="dash-section sd-finder" aria-labelledby="sd-find-title" data-finder>
  <h2 class="sr-only" id="sd-find-title">Find a business</h2>

  <div class="sd-layout">
    <div class="sd-filter-panel">
      <button type="button" class="near-btn sd-filter-toggle" aria-expanded="false" aria-controls="sd-filters" hidden data-filter-toggle>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
        Filters <span class="sd-filter-count" data-filter-count></span>
      </button>

      <form class="sd-filters" id="sd-filters" action={base} method="get" novalidate data-filters>
        <div class="sd-filter-grid">
          <fieldset class="sd-step" data-tone="pink">
            <legend class="sd-step-title">Certification</legend>
            <div class="sd-who">
              {(['WBE', 'MBE'] as const).map((c) => (
                <label class="sd-who-chip" data-tone={CERTS[c].tone}>
                  <input type="checkbox" name="who" value={c.toLowerCase()} checked={who(c)} />
                  <span class="sd-who-text">
                    <span class="sd-who-label">{CERTS[c].label} <span class="sd-who-code">({c})</span></span>
                    <span class="sd-count" data-who-count={c}>{facets ? count(facets.who[c]) : ''}</span>
                  </span>
                </label>
              ))}
            </div>

            <fieldset class="sd-sub-fieldset" data-match hidden={!(who('WBE') && who('MBE'))}>
              <legend class="filter-label">Show businesses that are</legend>
              <div class="sd-radio-row">
                <label class="pay-chip"><input type="radio" name="match" value="any" checked={query.match !== 'all'} /> Either</label>
                <label class="pay-chip"><input type="radio" name="match" value="all" checked={query.match === 'all'} /> Both</label>
              </div>
            </fieldset>

            <fieldset class="sd-sub-fieldset" data-eth hidden={!who('MBE')}>
              <legend class="filter-label">Owner ethnicity <span class="field-optional">(optional, any of)</span></legend>
              <div class="sd-radio-row" data-eth-chips set:html={facets ? ethnicityChipsHtml(facets.eth, query.eth) : ''}></div>
            </fieldset>
          </fieldset>

          <fieldset class="sd-step" data-tone="purple">
            <legend class="sd-step-title">Scope of work</legend>
            <div class="field">
              <label class="filter-label" for="sd-code">NAICS or NIGP codes <span class="field-optional">(optional, any of)</span></label>
              <input class="search-input" id="sd-code" name="code" type="text" inputmode="numeric" value={query.code.join(', ') || rawCode}
                autocomplete="off" enterkeyhint="search" placeholder="e.g. 238210, 914" aria-describedby="sd-code-error sd-code-hint"
                aria-invalid={codeInvalid ? 'true' : undefined} data-code />
              <p class="field-error" id="sd-code-error" data-code-error hidden={!codeInvalid}>{CODE_ERROR}</p>
              <p class="field-hint" id="sd-code-hint">A code’s first digits find everything under it: 2382 finds every building equipment contractor, 914 every NIGP 914 item.</p>
            </div>
            <div class="field">
              <label class="filter-label" for="sd-cat">Category</label>
              <select class="filter-select" id="sd-cat" name="cat" data-cat
                set:html={facets ? categoryOptionsHtml(facets.categories, query.cat, 'All categories') : '<option value="">All categories</option>'}></select>
            </div>
            <div class="field" data-sub-field hidden={!query.cat || !facets?.subcategories.length}>
              <label class="filter-label" for="sd-sub">Subcategory</label>
              <select class="filter-select" id="sd-sub" name="sub" data-sub
                set:html={facets ? categoryOptionsHtml(facets.subcategories, query.sub, 'All subcategories') : ''}></select>
            </div>
            <div class="field">
              <label class="filter-label" for="sd-q">Keyword</label>
              <input class="search-input" id="sd-q" name="q" type="search" maxlength={MAX_KEYWORD_LENGTH} value={query.q}
                autocomplete="off" enterkeyhint="search" placeholder="Try “electrical” or “asbestos”" aria-describedby="sd-q-hint" data-q />
              <p class="field-hint" id="sd-q-hint">Searches names, descriptions and industries.</p>
            </div>
          </fieldset>

          <fieldset class="sd-step" data-tone="orange">
            <legend class="sd-step-title">Capacity</legend>
            <div class="field">
              <label class="filter-label" for="sd-bond">Bonding limit</label>
              <select class="filter-select" id="sd-bond" name="bond" aria-describedby="sd-capacity-hint" data-bond
                set:html={facets ? amountOptionsHtml(facets.bond, query.bond) : '<option value="">Any amount</option>'}></select>
            </div>
            <div class="field">
              <label class="filter-label" for="sd-contract">Largest past contract</label>
              <select class="filter-select" id="sd-contract" name="contract" aria-describedby="sd-capacity-hint" data-contract
                set:html={facets ? amountOptionsHtml(facets.contract, query.contract) : '<option value="">Any amount</option>'}></select>
            </div>
            <label class="sd-check">
              <input type="checkbox" name="union" value="1" checked={query.union} data-union />
              Signatory to union contracts <span class="sd-count" data-union-count>{facets ? count(facets.union) : ''}</span>
            </label>
            <p class="field-hint" id="sd-capacity-hint">
              Reported by each firm to SBS. Firms that leave a field blank drop out when you set it: few give a bonding
              limit or name a union, mostly construction firms.
            </p>
          </fieldset>

          <fieldset class="sd-step" data-tone="green">
            <legend class="sd-step-title">Location</legend>
            <div class="field">
              <label class="filter-label" for="sd-boro">Borough</label>
              <select class="filter-select" id="sd-boro" name="boro" data-boro
                set:html={facets ? boroughOptionsHtml(facets.boroughs, query.boro) : '<option value="">Anywhere</option>'}></select>
            </div>
            <div class="field">
              <label class="filter-label" for="sd-zip">Near ZIP code <span class="field-optional">(optional)</span></label>
              <input class="search-input" id="sd-zip" name="zip" type="text" inputmode="numeric" maxlength="5" pattern="[0-9]{5}"
                value={query.zip || rawZip} autocomplete="postal-code" enterkeyhint="search" placeholder="e.g. 11216"
                aria-describedby="sd-zip-error sd-zip-hint" aria-invalid={zipInvalid ? 'true' : undefined} data-zip />
              <p class="field-error" id="sd-zip-error" data-zip-error hidden={!zipInvalid}>{ZIP_ERROR}</p>
              <p class="field-hint" id="sd-zip-hint" data-zip-hint>{zipHint(query.sort)}</p>
            </div>
          </fieldset>
        </div>

        <div class="sd-filter-foot">
          <label class="sd-lapsed" data-lapsed-wrap hidden={!query.lapsed && !facets?.lapsed}>
            <input type="checkbox" name="lapsed" value="1" checked={query.lapsed} data-lapsed />
            Include lapsed certifications <span class="sd-count" data-lapsed-count>{facets ? count(facets.lapsed) : ''}</span>
          </label>

          <div class="sd-filter-actions">
            <noscript><button type="submit" class="near-btn">Show businesses</button></noscript>
            <a class="sd-clear" href={base} data-clear>Clear filters</a>
          </div>
        </div>

        {/* Phones: closes the drawer and goes to the results (shown only when the script opens the drawer) */}
        <button type="button" class="near-btn sd-show-results" data-show-results>{showResultsText}</button>
      </form>
    </div>

    <div class="sd-results-col">
      <div class="sd-active" hidden={!chips.length} data-active set:html={activeFiltersHtml(chips, pageUrl, base)}></div>

      <section class="sd-shortlist" aria-labelledby="sd-shortlist-title" data-shortlist-bar hidden>
        <h2 class="sd-shortlist-title" id="sd-shortlist-title">Your shortlist</h2>
        <p class="sd-shortlist-count" data-shortlist-count></p>
        <ul class="sd-shortlist-names" data-shortlist-names></ul>
        <div class="sd-shortlist-actions">
          <a class="near-btn" href="#" data-shortlist-csv>Download shortlist (CSV)</a>
          <button type="button" class="sd-clear sd-link-btn" data-shortlist-clear>Clear shortlist</button>
          <span class="sd-copy-status" role="status" data-shortlist-status></span>
        </div>
        <p class="field-hint">
          Saved in this browser only, up to {MAX_EXPORT} businesses. The file has each firm’s contact, certifications,
          codes, bonding limit, largest contract and union contracts. Confirm certifications in the SBS directory before
          you count a firm toward a goal.
        </p>
      </section>

      <ul class="sd-kpis" aria-label="Matching businesses" data-kpis set:html={initial ? kpisHtml(initial.kpis, query) : ''}></ul>

      <div class="sd-results-head">
        <p class="sd-status" role="status" aria-live="polite" data-status>{status}</p>
        <div class="sd-sort">
          <label class="filter-label" for="sd-sort">Sort by</label>
          <select class="filter-select" id="sd-sort" name="sort" form="sd-filters" data-sort>
            {SORTS.map((s) => <option value={s.value} selected={s.value === query.sort}>{s.label}</option>)}
          </select>
          <details class="sd-why">
            <summary>Why this order?</summary>
            <div class="sd-why-body">
              <p>
                <strong>Recommended</strong> puts first the businesses that best match your keyword and category, are based in
                the five boroughs, are easiest to reach (website, phone, a real description) and have more years in business
                (up to {POINTS.maxYearsCounted}).
                Lapsed certifications go last.
              </p>
              <p>
                Owner ethnicity and gender are filters only. They never move a business up or down. Ties are shuffled once a
                day. <a href="#why-this-order" data-why-link>See the full rules</a>.
              </p>
            </div>
          </details>
        </div>
      </div>

      <ul class="sd-results" id="sd-results" aria-label="Businesses" data-results
        set:html={initial ? cardsHtml(initial.results, (id: string) => hrefWith({ biz: id })) : ''}></ul>

      <div class="sd-empty" data-empty hidden={!initial || initial.total > 0}>
        <p class="sd-empty-title">No businesses match these filters.</p>
        <p>Try removing a filter or shortening your keyword.</p>
        <a class="near-btn" href={base} data-clear>Clear filters</a>
      </div>

      <nav class="pager sd-pager" aria-label="Result pages" data-pager set:html={initial ? pagerHtml(initial, pageHref) : ''}></nav>

      <p class="sd-export" data-export-wrap hidden={!initial?.total}>
        <a class="download-link" href={searchExportUrl(query)} download data-export>Download these results (CSV)</a>
        <span class="field-hint">The first {MAX_EXPORT}, in this order.</span>
        <span class="sd-copy-status" role="status" data-export-status></span>
      </p>
    </div>
  </div>
</section>

<dialog class="sd-detail" aria-labelledby={detail ? 'sd-detail-title' : undefined} aria-label={detail ? undefined : DETAIL_LABEL} data-detail>
  <div class="sd-detail-bar">
    <a class="sd-close" href={listHref} data-close>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      Close
    </a>
  </div>
  <div class="sd-detail-body" data-detail-body>
    {detail && <Fragment set:html={detailHtml(detail)} />}
    {business?.missing && <p class="sd-detail-error" role="alert">{NOT_FOUND_TEXT}</p>}
  </div>
</dialog>
{business && <noscript><style is:inline>.sd-detail { display: block; }</style></noscript>}

<script type="application/json" id="sd-initial" set:html={initialJson}></script>

<script>
  import { normalizeQuery, queryToParams, codesValid } from '../../lib/shop-diverse/filter.js';
  import {
    BASE, pageUrl, formQuery, startQuery, popstateAction, closeAction, activeFilters, plainClick,
    SHORTLIST_KEY, parseShortlist, toggleShortlist, shortlistExportUrl, searchExportUrl
  } from '../../lib/shop-diverse/page-state.js';
  import {
    kpisHtml, cardsHtml, skeletonCards, pagerHtml, statusText, categoryOptionsHtml, amountOptionsHtml,
    boroughOptionsHtml, ethnicityChipsHtml, activeFiltersHtml, detailHtml, contactText, zipHint, showResultsLabel, UPSTREAM_TEXT, LOADING_TEXT,
    NOT_FOUND_TEXT, DETAIL_LABEL
  } from '../../lib/shop-diverse/render.js';
  import { MAX_EXPORT } from '../../lib/shop-diverse/config.js';
  import { count } from '../../lib/format.js';

  const DEBOUNCE_MS = 350;
  // Only a slow search says "Loading" in the status line, so screen readers
  // hear the result count, not a loading message for every pause in typing.
  const LOADING_DELAY_MS = 1000;

  const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
  const form = $<HTMLFormElement>('[data-filters]');
  const catSelect = $<HTMLSelectElement>('[data-cat]');
  const subSelect = $<HTMLSelectElement>('[data-sub]');
  const subField = $('[data-sub-field]');
  const boroSelect = $<HTMLSelectElement>('[data-boro]');
  const qInput = $<HTMLInputElement>('[data-q]');
  const zipInput = $<HTMLInputElement>('[data-zip]');
  const zipError = $('[data-zip-error]');
  const zipHintText = $('[data-zip-hint]');
  const codeInput = $<HTMLInputElement>('[data-code]');
  const codeError = $('[data-code-error]');
  const bondSelect = $<HTMLSelectElement>('[data-bond]');
  const contractSelect = $<HTMLSelectElement>('[data-contract]');
  const unionBox = $<HTMLInputElement>('[data-union]');
  const sortSelect = $<HTMLSelectElement>('[data-sort]');
  const lapsedWrap = $('[data-lapsed-wrap]');
  const lapsedBox = $<HTMLInputElement>('[data-lapsed]');
  const matchSet = $('[data-match]');
  const ethSet = $('[data-eth]');
  const ethChips = $('[data-eth-chips]');
  const status = $('[data-status]');
  const list = $<HTMLUListElement>('[data-results]');
  const empty = $('[data-empty]');
  const pager = $('[data-pager]');
  const kpis = $('[data-kpis]');
  const filterToggle = $<HTMLButtonElement>('[data-filter-toggle]');
  const filterCount = $('[data-filter-count]');
  const active = $('[data-active]');
  const showResults = $<HTMLButtonElement>('[data-show-results]');
  const dialog = $<HTMLDialogElement>('[data-detail]');
  const detailBody = $('[data-detail-body]');
  const finder = $('[data-finder]');
  const shortlistBar = $('[data-shortlist-bar]');
  const shortlistCount = $('[data-shortlist-count]');
  const shortlistNames = $<HTMLUListElement>('[data-shortlist-names]');
  const shortlistCsv = $<HTMLAnchorElement>('[data-shortlist-csv]');
  const shortlistStatus = $('[data-shortlist-status]');
  const exportWrap = $('[data-export-wrap]');
  const exportLink = $<HTMLAnchorElement>('[data-export]');
  const exportStatus = $('[data-export-status]');

  const initial = JSON.parse(document.getElementById('sd-initial')!.textContent || '{}');
  let query: any = initial.query;
  let searchAbort: AbortController | null = null;
  let detailAbort: AbortController | null = null;
  let current: any = null; // the business in the panel
  let openedId: string | null = null; // the business the panel was opened for, loaded or not
  let typingTimer = 0; // 0 when no keyword or ZIP search is pending
  let copyTimer = 0;
  let loadingTimer = 0;
  const coarsePointer = matchMedia('(pointer: coarse)');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  // ---------- URL ----------
  // The decisions about URLs, the form and history are in page-state.js, with tests.
  const bizParam = () => new URL(location.href).searchParams.get('biz');

  // ---------- Form ↔ query ----------
  const readForm = () => formQuery(new FormData(form), sortSelect.value);

  function fillForm(q: any) {
    form.querySelectorAll<HTMLInputElement>('input[name="who"]').forEach((b) => { b.checked = q.who.includes(b.value.toUpperCase()); });
    form.querySelectorAll<HTMLInputElement>('input[name="match"]').forEach((b) => { b.checked = b.value === q.match; });
    qInput.value = q.q;
    zipInput.value = q.zip;
    codeInput.value = q.code.join(', ');
    unionBox.checked = q.union;
    sortSelect.value = q.sort;
    lapsedBox.checked = q.lapsed;
    showZipError(false);
    showCodeError(false);
    // Category, subcategory, borough, amount and ethnicity options come back with the results.
    syncVisibility(q);
  }

  function syncVisibility(q: any) {
    matchSet.hidden = !(q.who.includes('WBE') && q.who.includes('MBE'));
    ethSet.hidden = !q.who.includes('MBE');
    zipHintText.textContent = zipHint(q.sort);
  }

  // A ZIP that isn't 5 digits is left out of the search; say so once the
  // visitor has finished typing (change, submit), not on every keystroke.
  const zipIsValid = () => !zipInput.value.trim() || /^\d{5}$/.test(zipInput.value.trim());
  function showZipError(show: boolean) {
    zipError.hidden = !show;
    if (show) zipInput.setAttribute('aria-invalid', 'true'); else zipInput.removeAttribute('aria-invalid');
  }

  // The same for codes: "plumbing" or a half-typed "2" waits.
  const codeIsValid = () => codesValid(codeInput.value);
  function showCodeError(show: boolean) {
    codeError.hidden = !show;
    if (show) codeInput.setAttribute('aria-invalid', 'true'); else codeInput.removeAttribute('aria-invalid');
  }

  // ---------- Render ----------
  function render(data: any) {
    const f = data.facets;
    for (const c of ['WBE', 'MBE']) $(`[data-who-count="${c}"]`).textContent = count(f.who[c]);
    ethChips.innerHTML = ethnicityChipsHtml(f.eth, query.eth);
    catSelect.innerHTML = categoryOptionsHtml(f.categories, query.cat, 'All categories');
    subSelect.innerHTML = categoryOptionsHtml(f.subcategories, query.sub, 'All subcategories');
    subField.hidden = !query.cat || !f.subcategories.length;
    boroSelect.innerHTML = boroughOptionsHtml(f.boroughs, query.boro);
    bondSelect.innerHTML = amountOptionsHtml(f.bond, query.bond);
    contractSelect.innerHTML = amountOptionsHtml(f.contract, query.contract);
    $('[data-union-count]').textContent = count(f.union);
    lapsedWrap.hidden = !query.lapsed && !f.lapsed;
    $('[data-lapsed-count]').textContent = count(f.lapsed);

    kpis.innerHTML = kpisHtml(data.kpis, query);

    list.innerHTML = cardsHtml(data.results, (id: string) => pageUrl(query, { biz: id }), shortlistIds());
    empty.hidden = data.total > 0;
    exportLink.href = searchExportUrl(query);
    exportWrap.hidden = !data.total;
    exportStatus.textContent = '';
    pager.innerHTML = pagerHtml(data, (page: number) => pageUrl({ ...query, page }));
    status.textContent = statusText(data);
    showResults.textContent = showResultsLabel(data.total);
  }

  // The active-filter chips and the phones' count follow the query, not the results.
  let chips: any[] = [];
  function renderActive() {
    chips = activeFilters(query);
    active.innerHTML = activeFiltersHtml(chips, pageUrl, BASE);
    active.hidden = !chips.length;
    filterCount.textContent = chips.length ? `(${chips.length})` : '';
  }

  // An error leaves nothing from the last view: no cards, pager, summary or counts.
  function clearResults() {
    list.replaceChildren();
    pager.replaceChildren();
    kpis.replaceChildren();
    exportWrap.hidden = true;
    form.querySelectorAll('.sd-count').forEach((el) => { el.textContent = ''; });
    form.querySelectorAll<HTMLInputElement>('input[name="eth"]').forEach((b) => { b.disabled = false; });
    form.querySelectorAll('select option').forEach((o) => { o.textContent = o.textContent!.replace(/ \([\d,]+\)$/, ''); });
    showResults.textContent = 'Show results';
  }

  // push adds a history entry (with state) so Back undoes this step;
  // otherwise the current entry is updated in place.
  async function search({ push = false, scroll = false, state = null as any } = {}) {
    clearTimeout(typingTimer);
    typingTimer = 0;
    searchAbort?.abort();
    searchAbort = new AbortController();
    syncVisibility(query);
    renderActive();
    const biz = bizParam();
    const url = pageUrl(query, biz ? { biz } : {});
    if (url !== location.pathname + location.search) {
      if (push) history.pushState(state, '', url); else history.replaceState(history.state, '', url);
    }

    clearTimeout(loadingTimer);
    loadingTimer = window.setTimeout(() => { status.textContent = LOADING_TEXT; }, LOADING_DELAY_MS);
    list.setAttribute('aria-busy', 'true');
    list.innerHTML = skeletonCards();
    empty.hidden = true;
    try {
      const res = await fetch(`/api/shop-diverse/search?${queryToParams(query)}`, { signal: searchAbort.signal });
      const data = await res.json().catch(() => null);
      clearTimeout(loadingTimer);
      if ((res.status === 400 || res.status === 429) && typeof data?.error === 'string') {
        clearResults();
        status.textContent = data.error;
        return;
      }
      if (!res.ok || !Array.isArray(data?.results)) throw new Error('upstream');
      // The server clamps a page past the end; keep the URL honest.
      if (data.page !== query.page) {
        query = { ...query, page: data.page };
        history.replaceState(history.state, '', pageUrl(query, biz ? { biz } : {}));
      }
      render(data);
      if (scroll) $('.sd-results-head').scrollIntoView({ block: 'start', behavior: reducedMotion.matches ? 'auto' : 'smooth' });
    } catch (err: any) {
      if (err.name === 'AbortError') return;
      clearTimeout(loadingTimer);
      clearResults();
      status.textContent = UPSTREAM_TEXT;
    } finally {
      list.removeAttribute('aria-busy');
    }
  }

  // A filter changed: back to page 1, as a new history entry so Back undoes
  // it. A run of typing in the keyword or ZIP box is one entry ({ typing }),
  // updated as the search follows the typing.
  function applyForm({ typing = false } = {}) {
    const { query: q, error } = readForm();
    if (error) { status.textContent = error; return; }
    query = { ...q, page: 1 };
    search({ push: !(typing && history.state?.typing), state: typing ? { typing: true } : null });
  }

  // Leaving the keyword or ZIP box ends its run of typing: a search still
  // waiting goes now, and the next one gets its own entry.
  function endTyping() {
    if (typingTimer) applyForm({ typing: true });
    if (history.state?.typing) history.replaceState(null, '', location.href);
  }

  form.addEventListener('change', (e) => {
    const target = e.target as HTMLElement;
    if (target === zipInput) showZipError(!zipIsValid());
    if (target === codeInput) showCodeError(!codeIsValid());
    if (target === zipInput || target === qInput || target === codeInput) return endTyping(); // searched on input
    if (target === catSelect) subSelect.value = '';
    applyForm();
  });
  sortSelect.addEventListener('change', () => applyForm());
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    showZipError(!zipIsValid());
    showCodeError(!codeIsValid());
    applyForm();
  });
  for (const input of [qInput, codeInput, zipInput]) {
    // With several text fields and no submit button the browser won't submit on
    // Enter, so do it here. On phones the Search key also closes the keyboard.
    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' || e.isComposing) return;
      e.preventDefault();
      form.requestSubmit();
      if (coarsePointer.matches) input.blur();
    });
    input.addEventListener('input', () => {
      if (input === zipInput) {
        // Wait for 5 digits, without cancelling a keyword search that's pending.
        if (!zipIsValid()) return;
        showZipError(false);
      }
      if (input === codeInput) {
        if (!codeIsValid()) return;
        showCodeError(false);
      }
      clearTimeout(typingTimer);
      typingTimer = window.setTimeout(() => applyForm({ typing: true }), DEBOUNCE_MS);
    });
  }

  // On phones the keyword box is hidden while the drawer is closed
  const focusFilters = () => (qInput.offsetParent ? qInput : filterToggle).focus();

  function clearFilters() {
    query = normalizeQuery(new URLSearchParams()).query;
    form.reset();
    fillForm(query);
    search({ push: true });
    focusFilters();
  }
  document.querySelectorAll<HTMLAnchorElement>('[data-clear]').forEach((link) => link.addEventListener('click', (e) => {
    e.preventDefault();
    clearFilters();
  }));

  // Removing one chip's filter; focus stays in the chips (the next one, or
  // the last), or goes to the filters once none are left.
  active.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-remove], a[data-clear]');
    if (!link || !plainClick(e)) return;
    e.preventDefault();
    if (link.hasAttribute('data-clear')) return clearFilters();
    const i = Number(link.dataset.remove);
    query = chips[i].query;
    fillForm(query);
    search({ push: true });
    const left = active.querySelectorAll<HTMLElement>('a[data-remove]');
    if (left.length) left[Math.min(i, left.length - 1)].focus(); else focusFilters();
  });

  pager.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-page]');
    if (!link || !plainClick(e)) return;
    e.preventDefault();
    query = { ...query, page: Number(link.dataset.page) };
    search({ push: true, scroll: true });
  });

  // "See the full rules" opens the method note at the bottom.
  $('[data-why-link]').addEventListener('click', () => {
    const rules = document.getElementById('why-this-order') as HTMLDetailsElement | null;
    if (rules) rules.open = true;
  });

  // Phones: the filter panel collapses into a drawer.
  function setDrawer(open: boolean) {
    filterToggle.setAttribute('aria-expanded', String(open));
    form.classList.toggle('is-open', open);
  }
  filterToggle.addEventListener('click', () => setDrawer(filterToggle.getAttribute('aria-expanded') !== 'true'));
  // Results update under the open drawer, out of sight; this closes it and goes to them.
  showResults.addEventListener('click', () => {
    setDrawer(false);
    filterToggle.focus({ preventScroll: true });
    $('.sd-results-head').scrollIntoView({ block: 'start', behavior: reducedMotion.matches ? 'auto' : 'smooth' });
  });

  // ---------- Detail ----------
  // Named by the business heading once it's there, a generic label until then.
  function nameDetail() {
    if (detailBody.querySelector('#sd-detail-title')) {
      dialog.setAttribute('aria-labelledby', 'sd-detail-title');
      dialog.removeAttribute('aria-label');
    } else {
      dialog.removeAttribute('aria-labelledby');
      dialog.setAttribute('aria-label', DETAIL_LABEL);
    }
  }

  function showDetailMessage(message: string) {
    current = null;
    detailBody.innerHTML = '<p class="sd-detail-error" role="alert"></p>';
    detailBody.querySelector('p')!.textContent = message;
    nameDetail();
  }

  async function openBusiness(id: string, { push = false } = {}) {
    detailAbort?.abort();
    detailAbort = new AbortController();
    openedId = id;
    if (push) history.pushState({ fromList: true }, '', pageUrl(query, { biz: id }));
    detailBody.setAttribute('aria-busy', 'true');
    detailBody.innerHTML = '<p class="sd-muted">Loading business details…</p><div class="sk-block"></div><div class="sk-block"></div>';
    nameDetail();
    if (!dialog.open) dialog.showModal();
    try {
      const res = await fetch(`/api/shop-diverse/business/${encodeURIComponent(id)}`, { signal: detailAbort.signal });
      if (res.status === 404 || res.status === 400) return showDetailMessage(NOT_FOUND_TEXT);
      const data = await res.json().catch(() => null);
      if (res.status === 429 && typeof data?.error === 'string') return showDetailMessage(data.error);
      if (!res.ok || !data) throw new Error('upstream');
      current = data;
      detailBody.innerHTML = detailHtml(data, shortlistIds());
      nameDetail();
      $('#sd-detail-title', detailBody).focus();
    } catch (err: any) {
      if (err.name !== 'AbortError') showDetailMessage(UPSTREAM_TEXT);
    } finally {
      detailBody.setAttribute('aria-busy', 'false');
    }
  }

  // Closing goes back if the card pushed the entry, so Back doesn't reopen it.
  function closeBusiness() {
    const action = closeAction(location.search, history.state);
    if (action === 'back') history.back();
    else if (action === 'replace') history.replaceState(null, '', pageUrl(query));
  }

  list.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.sd-card');
    if (!card || !plainClick(e)) return;
    e.preventDefault();
    openBusiness(card.dataset.id!, { push: true });
  });

  $('[data-close]', dialog).addEventListener('click', (e) => { e.preventDefault(); dialog.close(); });
  // A click on the backdrop lands on the dialog element itself.
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => {
    detailAbort?.abort();
    // The opener, even if the details failed to load or Back already cleared current
    const id = openedId;
    current = null;
    openedId = null;
    closeBusiness();
    // Back to the card that opened it
    if (id) list.querySelector<HTMLElement>(`a.sd-card[data-id="${CSS.escape(id)}"]`)?.focus();
  });

  detailBody.addEventListener('click', async (e) => {
    const copy = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
    if (!copy || !current) return;
    // Said beside the button, which keeps its label
    const copyStatus = $('[data-copy-status]', detailBody);
    clearTimeout(copyTimer);
    let ok = true;
    try {
      await navigator.clipboard.writeText(contactText(current));
      copyStatus.textContent = 'Contact info copied';
    } catch {
      ok = false;
      copyStatus.textContent = 'Couldn’t copy. Select the details above instead.';
    }
    copyTimer = window.setTimeout(() => { copyStatus.textContent = ''; }, ok ? 2500 : 8000);
  });

  // ---------- Shortlist ----------
  // In localStorage, which can be missing or throw (private windows, blocked
  // storage): then the shortlist lasts until the page is left.
  let shortlist = (() => {
    try { return parseShortlist(localStorage.getItem(SHORTLIST_KEY)); } catch { return []; }
  })();
  const shortlistIds = () => new Set(shortlist.map((i) => i.id));

  function saveShortlist() {
    try { localStorage.setItem(SHORTLIST_KEY, JSON.stringify(shortlist)); } catch { /* kept for this visit */ }
  }

  function renderShortlist() {
    const ids = shortlistIds();
    document.querySelectorAll<HTMLButtonElement>('[data-shortlist]').forEach((b) => {
      b.setAttribute('aria-pressed', String(ids.has(b.dataset.shortlist!)));
    });
    shortlistBar.hidden = !shortlist.length;
    shortlistCount.textContent = `${count(shortlist.length)} ${shortlist.length === 1 ? 'business' : 'businesses'}`;
    shortlistNames.replaceChildren(...shortlist.map((i) => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = pageUrl(query, { biz: i.id });
      a.dataset.open = i.id;
      a.textContent = i.name;
      const x = document.createElement('button');
      x.type = 'button';
      x.className = 'sd-shortlist-remove';
      x.dataset.shortlist = i.id;
      x.dataset.name = i.name;
      x.setAttribute('aria-label', `Remove ${i.name} from shortlist`);
      x.textContent = '×';
      li.append(a, x);
      return li;
    }));
    shortlistCsv.href = shortlistExportUrl(shortlist);
  }

  // Any [data-shortlist] button: on a card, in the panel or in the bar.
  function onShortlistClick(e: Event) {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-shortlist]');
    if (!btn) return false;
    const { list: next, full } = toggleShortlist(shortlist, { id: btn.dataset.shortlist!, name: btn.dataset.name! });
    if (full) {
      shortlistStatus.textContent = `Your shortlist is full (${MAX_EXPORT}). Download it, then clear it to start another.`;
      return true;
    }
    const removing = btn.classList.contains('sd-shortlist-remove');
    shortlist = next;
    saveShortlist();
    renderShortlist();
    shortlistStatus.textContent = '';
    // The bar's × button is gone once its business is; keep focus in the bar.
    if (removing) {
      const next = shortlistNames.querySelector<HTMLElement>('.sd-shortlist-remove');
      if (next) next.focus(); else focusFilters();
    }
    return true;
  }
  list.addEventListener('click', onShortlistClick);
  detailBody.addEventListener('click', onShortlistClick);
  shortlistBar.addEventListener('click', (e) => {
    if (onShortlistClick(e)) return;
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-open]');
    if (!link || !plainClick(e)) return;
    e.preventDefault();
    openBusiness(link.dataset.open!, { push: true });
  });
  $('[data-shortlist-clear]').addEventListener('click', () => {
    shortlist = [];
    saveShortlist();
    renderShortlist();
    focusFilters();
  });

  // Fetched rather than followed, so an error (rate limit, Socrata down) is
  // said beside the link instead of downloading as a file.
  async function download(link: HTMLAnchorElement, statusEl: HTMLElement, e: MouseEvent) {
    if (!plainClick(e)) return;
    e.preventDefault();
    statusEl.textContent = 'Preparing the file…';
    try {
      const res = await fetch(link.href);
      if (!res.ok) {
        const data = await res.json().catch(() => null);
        statusEl.textContent = typeof data?.error === 'string' && data.error !== 'upstream' ? data.error : UPSTREAM_TEXT;
        return;
      }
      const name = /filename="([^"]+)"/.exec(res.headers.get('Content-Disposition') ?? '')?.[1] ?? 'mwbe-businesses.csv';
      const url = URL.createObjectURL(await res.blob());
      const a = document.createElement('a');
      a.href = url;
      a.download = name;
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 10000);
      statusEl.textContent = 'Downloaded';
    } catch {
      statusEl.textContent = UPSTREAM_TEXT;
    }
  }
  shortlistCsv.addEventListener('click', (e) => download(shortlistCsv, shortlistStatus, e));
  exportLink.addEventListener('click', (e) => download(exportLink, exportStatus, e));

  // ---------- Back / forward ----------
  window.addEventListener('popstate', () => {
    const action = popstateAction(location.search, { query, currentId: current?.id ?? null, dialogOpen: dialog.open });
    if (action.query) {
      query = action.query;
      fillForm(query);
      search();
    }
    if (action.open) openBusiness(action.open);
    else if (action.close) { current = null; dialog.close(); }
  });

  // ---------- Start ----------
  // Phones: collapse the filters into the drawer (left open without script).
  form.classList.add('is-collapsible');
  filterToggle.hidden = false;
  finder.classList.add('has-shortlist');
  dialog.classList.add('has-shortlist');
  renderActive();
  renderShortlist();
  // The browser may have kept edited fields (back/forward cache, autofill).
  const startWith = startQuery(initial, readForm().query ?? null);
  if (startWith) {
    query = startWith;
    search();
  }
  const startBiz = bizParam();
  if (startBiz && initial.business?.id === startBiz) {
    // Rendered on the server: just open it.
    current = initial.business;
    openedId = startBiz;
    dialog.showModal();
    $('#sd-detail-title', detailBody).focus();
  } else if (startBiz) openBusiness(startBiz);
</script>

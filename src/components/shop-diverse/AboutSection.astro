---
/*
 * "How to read this list": what certification means, what the capacity
 * fields and codes are and how many firms give them, how the Recommended
 * order works (the same rules as src/lib/shop-diverse/ranking.js), the
 * shortlist file, data quirks, and the source.
 */
import { DATASET_URL, DATASET_NAME, DATASET_ID, LINKS, MAX_EXPORT } from '../../lib/shop-diverse/config.js';
import { POINTS } from '../../lib/shop-diverse/ranking.js';
import { date, count } from '../../lib/format.js';

interface Props {
  meta: { rowsUpdatedAt: string | null } | null;
  /** Share of listed businesses with no NYC borough (0–1), or null if the list didn't load. */
  outsideShare: number | null;
  /** How many firms give each capacity field (the daily job's coverage), or null. */
  coverage: { total: number; bonding: number; union: number; largestContract: number } | null;
}
const { meta, outsideShare, coverage } = Astro.props;
const of = (n: number) => `${count(n)} of ${count(coverage!.total)}`;
---

<section class="dash-section sd-about" aria-labelledby="sd-about-title">
  <h2 class="chart-title" id="sd-about-title">How to read this list</h2>

  <p class="callout callout-heads-up">
    <strong>Heads up:</strong> certification status comes from NYC Small Business Services (SBS). Before you count a
    firm toward an M/WBE goal, use the <a href={LINKS.sbsDirectory}>SBS Online Directory</a> to verify that its
    certification is current, and confirm capacity and union status directly with the firm.
  </p>

  <details class="about-data">
    <summary>What the certifications mean</summary>
    <div class="about-body">
      <p>
        <strong>Women-owned (WBE)</strong> and <strong>Minority-owned (MBE)</strong> businesses are at least 51% owned,
        operated and controlled by women, or by Black, Hispanic, Asian American or Native American owners. A business
        can hold both. <strong>Emerging (EBE)</strong> businesses are owned by people facing social and economic
        disadvantage, and <strong>Locally based (LBE)</strong> is a program for small construction firms. Only a handful
        of businesses on this list hold those two. <a href={LINKS.sbsCertification}>Read more from SBS</a>.
      </p>
      <p>
        Certified firms can work anywhere, so
        {outsideShare != null ? <>about {Math.round(outsideShare * 100)}% of the businesses</> : 'many businesses'} listed here are
        outside the five boroughs. Pick a borough under “Location” to narrow it down.
      </p>
    </div>
  </details>

  <details class="about-data">
    <summary>Codes, bonding and past contracts</summary>
    <div class="about-body">
      <p>
        Each firm is listed under one six-digit <strong>NAICS</strong> code (the federal industry classification) and
        any number of <strong>NIGP</strong> commodity codes, the codes City agencies buy under. A code finds every firm
        whose code starts with it, so 238 finds all specialty trade contractors and 238210 only electrical contractors.
      </p>
      <p>
        <strong>Bonding limit</strong> (the aggregate surety bonding a firm says it can get), <strong>largest past
        contract</strong> and <strong>union contracts</strong> come from each firm’s certification application, as
        reported. Most firms, especially outside construction, leave bonding and union blank:
        {coverage
          ? <> {of(coverage.bonding)} give a bonding limit, {of(coverage.union)} name a union and {of(coverage.largestContract)} give a largest contract.</>
          : ' few give a bonding limit or name a union.'}
        A firm with a blank field drops out when you filter on it, so it isn’t proof a firm lacks the capacity. Ask.
      </p>
      <p>
        <strong>Shortlist:</strong> add firms with the Shortlist button and download them as a spreadsheet (CSV) with
        contacts, certifications and renewal dates, codes and capacity. It’s saved in your browser only. “Download these
        results” gives the first {MAX_EXPORT} firms of any search the same way.
      </p>
    </div>
  </details>

  <details class="about-data" id="why-this-order">
    <summary>How “Recommended” orders businesses</summary>
    <div class="about-body">
      <p>
        Each business gets points, and the most points come first. Owner ethnicity, gender and certification type are
        filters only. They never change the order, except for a small bonus (+{POINTS.bothMbeWbe}) for businesses
        holding both MBE and WBE when you've asked for both.
      </p>
      <ul class="caveats">
        <li><strong>Lapsed certification:</strong> if every renewal date on file has passed, the business is hidden unless you ask for it, and then it sorts last. A business with no renewal date isn't marked down: SBS lists none for women-owned-only firms.</li>
        <li><strong>How well it matches:</strong> your keyword in the industry name +{POINTS.keywordTitle}, only in its broader group +{POINTS.keywordIndustry}, in the business name +{POINTS.keywordName}, only in the description +{POINTS.keywordDescription}. Picking a category or subcategory adds the same points to every result.</li>
        <li><strong>Easy to reach:</strong> a website +{POINTS.website}, a description of {POINTS.minDescriptionLength}+ characters +{POINTS.description}, a phone number +{POINTS.phone}.</li>
        <li><strong>Experience:</strong> +{POINTS.perYearInBusiness} per year in business, up to {POINTS.maxYearsCounted} years, so newer businesses aren't buried.</li>
        <li><strong>In New York City:</strong> +{POINTS.inNyc} for a business in one of the five boroughs, so local firms come first when nothing else separates them. A business elsewhere that matches your keyword in its industry still beats a local one that only mentions it.</li>
        <li><strong>Near your ZIP:</strong> if you enter one, the same ZIP +{POINTS.sameZip}, otherwise the same borough +{POINTS.sameBorough}.</li>
        <li><strong>Ties</strong> are broken by a shuffle that changes once a day, so the same businesses don't always come first.</li>
      </ul>
    </div>
  </details>

  <details class="about-data">
    <summary>How we cleaned the data</summary>
    <div class="about-body">
      <p>
        There's one row per business. We tidy names written in all caps, format phone numbers, add https:// to bare
        website addresses and drop ones that aren't web addresses (like “N/A” or a company name), put back the leading
        zero that New Jersey and New England ZIP codes lose, and ignore establishment dates in the future. Businesses at a
        New York address without a borough get one from their ZIP code. The list has no email addresses.
      </p>
    </div>
  </details>

  <footer class="section-sources">
    <h3 class="sources-title">Where this comes from</h3>
    <p>
      <a href={DATASET_URL}>{DATASET_NAME}</a> on NYC Open Data (dataset {DATASET_ID}), published by NYC Small
      Business Services.
      {meta?.rowsUpdatedAt && <> Last updated {date(meta.rowsUpdatedAt)}. </>}
      SBS updates the list about every two weeks; we check for changes daily.
    </p>
    <ul class="caveats">
      <li>Business descriptions, contacts and past clients are written by the businesses themselves.</li>
      <li>Each business is listed under one industry code, even if it does more than one kind of work.</li>
    </ul>
    <p><a href={DATASET_URL}>Report a data problem</a> to NYC Open Data.</p>
  </footer>
</section>

---
/*
 * Light / dark switch for the site header. Shows the icon for the theme it
 * switches to; ThemeInit.astro must be in <head>.
 */
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode">
  <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
  <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
</button>

<script is:inline>
  (function () {
    var btn = document.querySelector("[data-theme-toggle]");
    var root = document.documentElement;
    function label() {
      btn.setAttribute("aria-label", root.dataset.theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
    }
    label();
    new MutationObserver(label).observe(root, { attributes: true, attributeFilter: ["data-theme"] });
    btn.addEventListener("click", function () {
      window.anycdSetTheme(root.dataset.theme === "dark" ? "light" : "dark");
    });
  })();
</script>

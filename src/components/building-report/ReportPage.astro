---
/*
 * Shell shared by the Building Report Card's pages: the search page and
 * overview (src/pages/building-report/index.astro) and each part
 * ([part].astro). Sets the status, caching, title and description from the
 * lot the page looked up (lotForPage()), then the report and the glossary.
 * A lot that was too slow to wait for (bbl set, lot null, no error) goes out
 * with the plain title, uncached; the page loads the lot and retitles itself.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import BuildingReport from './BuildingReport.astro';
import AboutSection from './AboutSection.astro';
import { buildingPath } from '../../lib/building-report/config.js';
import { lotName } from '../../lib/building-report/summarize.js';
import { RATE_LIMITED_TEXT } from '../../lib/server/rate-limit.js';
import { UPSTREAM_TEXT, LOT_NOT_FOUND_TEXT, reportTitle } from '../../lib/building-report/render.js';

interface Props {
  part: string;           // PARTS id, or "all"
  bbl: string | null;     // lotForPage()
  lot: any;
  error: string | null;
}
const { part, bbl, lot, error } = Astro.props;
const pending = Boolean(bbl) && !lot && !error;

if (error === 'not-found') Astro.response.status = 404;
if (error === 'rate-limited') Astro.response.status = 429;
Astro.response.headers.set('Cache-Control', error || pending ? 'no-store' : 'public, max-age=300');

const errorText = {
  'not-found': LOT_NOT_FOUND_TEXT,
  'rate-limited': RATE_LIMITED_TEXT,
  'upstream': UPSTREAM_TEXT
}[error ?? ''] ?? null;

const name = lot ? lotName(lot) : null;
const title = reportTitle(lot, part);
const description = name
  ? `Open repair orders, tenant complaints, bedbugs, pests, vacate orders, court cases and the registered owner for ${name} (BBL ${lot.bbl}), from NYC Open Data.`
  : 'Type an NYC address and see the building’s record: repairs the city ordered, tenant complaints, bedbugs and pests, court cases and who owns it.';
---

<DashboardLayout
  title={title}
  description={description}
  path={lot || pending ? buildingPath(bbl, part) : '/building-report/'}
  category="Housing & Development"
  reportLink
>
  <header class="page-head">
    <h1>Building Report Card</h1>
    {!lot && !pending && (
      <p>
        Renting, buying or just curious? Type an address and see what the city has on file for the building:
        repairs it ordered, tenant complaints, bedbugs, court cases and who owns it. No score, just the records.
      </p>
    )}
  </header>

  <BuildingReport bbl={lot || pending ? bbl : null} lot={lot} part={part} errorText={errorText} />
  <AboutSection />
</DashboardLayout>

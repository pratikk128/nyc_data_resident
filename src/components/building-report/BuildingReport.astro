---
/*
 * The Building Report Card: an address box (with suggestions) and, for a
 * building (?bbl=), its header and map, the part cards (SectionNav) and one
 * part: the overview's key takeaways, or a topic's sections in full. The
 * server renders the header from the lot, or, when the lot was too slow to
 * wait for, sends the page with a placeholder header and the browser asks
 * /api/building-report/lot for it. With the lot, the browser asks for each
 * section the page needs at once (/api/building-report/:section), so each
 * loads, fails and retries on its own. A "Heads up" line shows on every part when
 * the building has a serious warning (a vacate order, the city's watch list,
 * an open court case). What each section says is in
 * src/lib/building-report/render.js.
 *
 * Picking an address goes to the building's own page (?bbl=…), so every
 * building has a link to share and the server can title it.
 */
import SectionNav from '../SectionNav.astro';
import SectionPager from '../SectionPager.astro';
import { MAX_INPUT_LENGTH } from '../../lib/complaints311/location-input.js';
import { SECTIONS, PARTS, buildingPath, partById } from '../../lib/building-report/config.js';
import { lotHeadHtml, LOT_HEAD_LOADING } from '../../lib/building-report/render.js';

interface Props {
  bbl: string | null;     // the building's BBL, or null on the search page
  lot: any;               // summarizeLot(), or null on the search page or while it loads
  part: string;           // PARTS id, or "all"
  errorText: string | null;
}
const { bbl, lot, part, errorText } = Astro.props;

const INTROS: Record<string, string> = {
  flags: 'Orders to leave the building, the city’s watch list for neglected buildings, and court cases the city has open against the owner.',
  violations: 'Problems an inspector from HPD, the city’s housing agency, saw and ordered the owner to fix, from leaks to no heat. Officially called violations.',
  complaints: 'What tenants reported to 311 or HPD. A complaint isn’t a repair order until an inspector confirms it.',
  repairs: 'Emergencies the owner didn’t fix, so the city hired someone to do it and billed the owner.',
  bedbugs: 'Building owners must tell the city once a year how many apartments had bedbugs.',
  hygiene: 'Open repair orders for pests, mold and garbage, and what tenants complained about.',
  dob: 'From the Department of Buildings: the structure, elevators, boilers, gas and construction.',
  court: 'Cases the city brought against the owner in Housing Court.',
  landlord: 'The owner’s yearly registration with the city, and who’s listed on it.'
};
// The overview's key takeaways, grouped by the part that has the details.
const TAKEAWAYS: Record<string, { key: string; label: string }[]> = {
  repairs: [
    { key: 'violations', label: 'Open repair orders' },
    { key: 'complaints', label: 'Tenant complaints, last 12 months' },
    { key: 'repairs', label: 'Times the city made emergency repairs' }
  ],
  pests: [
    { key: 'bedbugs', label: 'Apartments with bedbugs' },
    { key: 'hygiene', label: 'Open orders for pests, mold or garbage' }
  ],
  legal: [
    { key: 'flags', label: 'Serious warnings' },
    { key: 'dob', label: 'Open building-safety violations' },
    { key: 'landlord', label: 'Owner' }
  ]
};

const current = partById(part)!;
const showTakeaways = part === 'overview' || part === 'all';
const sections = SECTIONS.filter((s) => current.sections.includes(s.key))
  .sort((a, b) => current.sections.indexOf(a.key) - current.sections.indexOf(b.key));
const nav = bbl ? PARTS.map((p) => ({ id: p.id, href: buildingPath(bbl, p.id), label: p.label, blurb: p.blurb })) : [];
// On the all-in-one page a takeaway group jumps to its first section; elsewhere it opens the part.
const detailsHref = (id: string) => part === 'all' ? `#br-${partById(id)!.sections[0]}` : buildingPath(bbl, id);
const lotJson = lot ? JSON.stringify(lot) : '';
---

<div class="ar br" data-br data-bbl={bbl ?? ''} data-lot={lotJson} data-part={part}>
  <section class:list={['dash-section hn-find', { 'br-find-compact': bbl }]} id="find" aria-labelledby="br-find-title">
    <h2 class="sr-only" id="br-find-title">Search</h2>
    <form class="hn-search" data-form novalidate role="search" aria-label="Find a building by address" action="/building-report/">
      <label class="filter-label" for="br-address">{bbl ? 'Look up another building' : 'Building address'}</label>
      <div class="hn-search-row br-search-row">
        <div class="c311-combo hn-field">
          <input class="search-input" id="br-address" name="q" type="text" role="combobox" aria-autocomplete="list"
            aria-expanded="false" aria-controls="br-address-list" autocomplete="street-address" spellcheck="false"
            maxlength={MAX_INPUT_LENGTH} placeholder="House number, street and borough" data-address />
          <ul class="c311-suggest" id="br-address-list" role="listbox" aria-label="Address suggestions" hidden data-address-list></ul>
        </div>
        <button type="submit" class="c311-go">Get the report</button>
      </div>
    </form>
    <div class="scl-suggest-chips" data-address-choices hidden></div>
    <p class="rest-status" role="status" aria-live="polite" data-status>{errorText}</p>
    <noscript><p class="rest-status">The report needs JavaScript to look up addresses and load its sections.</p></noscript>
  </section>

  {bbl && (
    <section class="ar-results" id="report" aria-labelledby="br-title">
      <header class="br-head" data-head tabindex="-1" aria-busy={lot ? undefined : 'true'} set:html={lot ? lotHeadHtml(lot) : LOT_HEAD_LOADING} />

      <SectionNav sections={nav} current={part} label="Parts of this building’s report" />

      <aside class="callout callout-heads-up br-alert" role="note" data-alert hidden></aside>

      {showTakeaways && (
        <section class="br-takeaways" aria-labelledby="br-take-title">
          <h3 class="br-part-title" id="br-take-title">Key takeaways</h3>
          <div class="br-take-groups">
            {PARTS.filter((p) => TAKEAWAYS[p.id]).map((p) => (
              <div class="br-take-group">
                <h4 class="br-take-group-title">
                  <span class="section-bullet" aria-hidden="true">{PARTS.indexOf(p) + 1}</span>{p.label}
                </h4>
                <ul class="br-take-list">
                  {TAKEAWAYS[p.id].map((t) => (
                    <li class="br-take" data-take={t.key} data-tone="loading" tabindex="-1">
                      <span class="br-take-label">{t.label}</span>
                      <span class="br-take-value" data-take-value>…</span>
                      <span class="br-take-text" data-take-text>Checking…</span>
                    </li>
                  ))}
                </ul>
                <a class="br-take-more" href={detailsHref(p.id)}>See the details<span aria-hidden="true"> →</span><span class="sr-only">: {p.label}</span></a>
              </div>
            ))}
          </div>
          {part === 'overview' && (
            <p class="br-all-link">Want it all at once? <a href={buildingPath(bbl, 'all')}>See every record on one page</a></p>
          )}
        </section>
      )}

      {sections.length > 0 && (
        <div class="br-sections">
          {sections.map((s) => (
            <section class="ar-card br-section" id={`br-${s.key}`} tabindex="-1" data-section={s.key}
              aria-labelledby={`br-${s.key}-title`} aria-busy="true">
              <h3 class="ar-card-title br-section-title" id={`br-${s.key}-title`}>{s.title}</h3>
              <p class="ar-card-scope">{INTROS[s.key]}</p>
              <div class="ar-body" data-body>
                <span class="sk-line"></span><span class="sk-line sk-short"></span><span class="sk-line"></span>
              </div>
              <div data-sources></div>
            </section>
          ))}
        </div>
      )}

      {part !== 'all' && <SectionPager sections={nav} current={part} />}
    </section>
  )}
</div>

<script>
  import {
    flagsHtml, flagsTakeaway, flagsSummary, violationsHtml, violationsTakeaway, complaintsHtml, complaintsTakeaway,
    repairsHtml, repairsTakeaway, bedbugsHtml, bedbugsTakeaway, hygieneHtml, hygieneTakeaway, dobHtml, dobTakeaway,
    courtHtml, landlordHtml, landlordTakeaway, sourcesHtml, lotHeadHtml, reportTitle, escape, UPSTREAM_TEXT,
    LOT_NOT_FOUND_TEXT
  } from '../../lib/building-report/render.js';
  import { buildingPath, isBbl, partById } from '../../lib/building-report/config.js';
  import { findBuilding } from '../../lib/building-report/lookup.js';
  import { parseLocationInput } from '../../lib/complaints311/location-input.js';
  import { suggest } from '../../lib/complaints311/geocode.js';
  import { mountNearbyMap } from '../../lib/maps/nearby-map.js';

  const TIMEOUT_TEXT = 'NYC Open Data is taking too long to answer. Try again in a minute.';
  // The API's not-found: the lot dropped out of every dataset since the page loaded.
  const NOT_FOUND_TEXT = 'We couldn’t find this building’s records just now. Reload the page, or search for the address again.';
  // A few HPD queries take Socrata several seconds when its cache is cold.
  const TIMEOUT_MS = 45000;

  const root = document.querySelector<HTMLElement>('[data-br]')!;
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const form = $<HTMLFormElement>('[data-form]');
  const input = $<HTMLInputElement>('[data-address]');
  const list = $<HTMLUListElement>('[data-address-list]');
  const choices = $('[data-address-choices]');
  const status = $('[data-status]');
  const bbl = root.dataset.bbl || null;
  let lot = root.dataset.lot ? JSON.parse(root.dataset.lot) : null; // null until /api/building-report/lot answers
  const part = root.dataset.part!;

  // ---------- The report ----------

  async function getJson(url: string) {
    const ctl = new AbortController();
    let timedOut = false;
    const timer = setTimeout(() => { timedOut = true; ctl.abort(); }, TIMEOUT_MS);
    try {
      const res = await fetch(url, { signal: ctl.signal });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data || data.error) {
        const notFound = data?.error === 'not-found';
        throw Object.assign(
          new Error(notFound ? NOT_FOUND_TEXT : data?.error && data.error !== 'upstream' ? data.error : UPSTREAM_TEXT),
          { notFound }
        );
      }
      return data;
    } catch (err: any) {
      throw timedOut ? new Error(TIMEOUT_TEXT) : err;
    } finally {
      clearTimeout(timer);
    }
  }

  type Takeaway = { tone: string; value: string; text: string };

  function setTakeaway(key: string, t: Takeaway) {
    const el = root.querySelector<HTMLElement>(`[data-take="${key}"]`);
    if (!el) return;
    el.dataset.tone = t.tone;
    el.querySelector('[data-retry]')?.remove();
    el.querySelector('[data-take-value]')!.textContent = t.value;
    // Names (the owner) are longer than a number: a smaller size so they fit.
    el.querySelector('[data-take-value]')!.classList.toggle('br-take-value-text', t.value.length > 6);
    el.querySelector('[data-take-text]')!.textContent = t.text;
  }

  // Each section: its HTML, and its key takeaway if it has one.
  const VIEWS: Record<string, { html: (d: any, lot: any) => string; takeaway?: (d: any, lot: any) => Takeaway }> = {
    flags: { html: flagsHtml, takeaway: flagsTakeaway },
    violations: { html: violationsHtml, takeaway: violationsTakeaway },
    complaints: { html: complaintsHtml, takeaway: complaintsTakeaway },
    repairs: { html: repairsHtml, takeaway: repairsTakeaway },
    bedbugs: { html: bedbugsHtml, takeaway: bedbugsTakeaway },
    hygiene: { html: hygieneHtml, takeaway: hygieneTakeaway },
    dob: { html: dobHtml, takeaway: dobTakeaway },
    court: { html: courtHtml },
    landlord: { html: landlordHtml, takeaway: landlordTakeaway }
  };

  // A serious warning shows on every part but the one that has it in full.
  function showAlert(d: any) {
    const alert = $('[data-alert]');
    if (!d.active || partById(part)!.sections.includes('flags')) return;
    alert.innerHTML = `<strong>Heads up:</strong> ${escape(flagsSummary(d))}. ` +
      `<a href="${buildingPath(bbl!, 'legal')}">See safety, court &amp; owner</a>`;
    alert.hidden = false;
  }

  // "Try again" under a failed load (a section, a takeaway, the lot): runs retry, keeping focus nearby.
  function retryButton(retry: () => void, focusTo: HTMLElement) {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'near-btn ar-retry';
    btn.dataset.retry = '';
    btn.textContent = 'Try again';
    btn.addEventListener('click', () => {
      retry();
      focusTo.focus({ preventScroll: true });
    });
    return btn;
  }

  /*
   * One section, loaded on its own: its full view and/or its takeaway,
   * whichever this page has. A failed section or takeaway offers "Try
   * again", which loads just that section.
   */
  function loadSection(key: string) {
    const el = root.querySelector<HTMLElement>(`[data-section="${key}"]`);
    const body = el?.querySelector<HTMLElement>('[data-body]');
    const sources = el?.querySelector<HTMLElement>('[data-sources]');
    el?.setAttribute('aria-busy', 'true');
    if (body) body.innerHTML = '<span class="sk-line"></span><span class="sk-line sk-short"></span><span class="sk-line"></span>';
    if (sources) sources.innerHTML = '';
    setTakeaway(key, { tone: 'loading', value: '…', text: 'Checking…' });
    getJson(`/api/building-report/${key}?bbl=${bbl}`).then(
      (d) => {
        const view = VIEWS[key];
        if (body) body.innerHTML = view.html(d, lot);
        if (sources) sources.innerHTML = sourcesHtml(d.sources ?? []);
        if (view.takeaway) setTakeaway(key, view.takeaway(d, lot));
        if (key === 'flags') showAlert(d);
      },
      (err) => {
        const message = err?.message || UPSTREAM_TEXT;
        if (body) {
          body.innerHTML = `<p class="ar-error"><strong>Couldn’t load this section.</strong> ${escape(message)}</p>`;
          body.append(retryButton(() => loadSection(key), el!));
        }
        const take = root.querySelector<HTMLElement>(`[data-take="${key}"]`);
        if (take) {
          setTakeaway(key, { tone: 'none', value: '?', text: `Couldn’t load this. ${message}` });
          // A page with the section in full has its button there; the overview has only this one.
          if (!body) take.append(retryButton(() => loadSection(key), take));
        }
      }
    ).finally(() => el?.removeAttribute('aria-busy'));
  }

  // The header's "Copy link" and map, once it's drawn from the lot.
  function wireHead() {
    const copyBtn = $<HTMLButtonElement>('[data-copy]');
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(`${location.origin}${buildingPath(bbl!, part)}`);
        copyBtn.textContent = 'Link copied';
      } catch {
        copyBtn.textContent = 'Copy it from the address bar';
      }
      setTimeout(() => { copyBtn.textContent = 'Copy link'; }, 2500);
    });

    const mapEl = root.querySelector<HTMLElement>('[data-map]');
    if (mapEl && lot.lat != null) {
      const point = { lat: lot.lat, lon: lot.lon };
      // About a block each way, so the street grid shows around the dot.
      const box: any = [[lot.lat + 0.0018, lot.lon + 0.0024], [lot.lat - 0.0018, lot.lon - 0.0024]];
      mountNearbyMap(mapEl, { draw: () => [], drawHalo: () => {}, keyOf: () => '', fallback: 'The map couldn’t load.' })
        .update({ items: [], point, radiusMeters: null, fitTo: box });
    }
  }

  // This part's sections, the takeaways it shows, and the serious warnings (for the heads-up line).
  function loadSections() {
    const keys = new Set([
      ...partById(part)!.sections,
      ...[...root.querySelectorAll<HTMLElement>('[data-take]')].map((el) => el.dataset.take!),
      'flags'
    ]);
    for (const key of keys) loadSection(key);
  }

  /*
   * A page the server sent before the lot came back: the lot, then the
   * header, the title and the sections. Unknown, it says so where the
   * report was; a failure offers "Try again".
   */
  function loadLot() {
    const head = $('[data-head]');
    head.setAttribute('aria-busy', 'true');
    getJson(`/api/building-report/lot?bbl=${bbl}`).then(
      (d) => {
        lot = d.lot;
        head.innerHTML = lotHeadHtml(lot);
        document.title = `${reportTitle(lot, part)} | Ask NYC Data`;
        wireHead();
        loadSections();
      },
      (err) => {
        if (err?.notFound) {
          $('#report').remove();
          status.textContent = LOT_NOT_FOUND_TEXT;
          return;
        }
        head.innerHTML = `<div class="br-head-text"><h2 class="ar-place" id="br-title">Lot ${escape(bbl!)}</h2>` +
          `<p class="ar-error"><strong>Couldn’t load this building.</strong> ${escape(err?.message || UPSTREAM_TEXT)}</p></div>`;
        head.querySelector('.br-head-text')!.append(retryButton(loadLot, head));
      }
    ).finally(() => head.removeAttribute('aria-busy'));
  }

  if (lot) {
    wireHead();
    loadSections();
  } else if (bbl) {
    loadLot();
  }

  // ---------- Address box with suggestions ----------

  type Option = { label: string; bbl: string };
  let options: Option[] = [];
  let active = -1;
  let timer = 0;
  let suggestAbort: AbortController | null = null;
  let lookup = 0; // bumped by every search, so only the latest lookup counts

  const go = (bbl: string) => { location.href = buildingPath(bbl); };

  function renderOptions(next: Option[]) {
    options = next;
    active = -1;
    list.innerHTML = next.map((o, i) =>
      `<li role="option" id="br-opt-${i}" aria-selected="false" class="c311-option" data-i="${i}"><span>${escape(o.label)}</span></li>`).join('');
    list.hidden = !next.length;
    input.setAttribute('aria-expanded', String(next.length > 0));
    input.removeAttribute('aria-activedescendant');
  }
  const closeOptions = () => { clearTimeout(timer); suggestAbort?.abort(); renderOptions([]); };

  function highlightOption(i: number) {
    active = i;
    list.querySelectorAll('[role="option"]').forEach((el, j) => el.setAttribute('aria-selected', String(j === i)));
    if (i >= 0) {
      input.setAttribute('aria-activedescendant', `br-opt-${i}`);
      list.children[i]?.scrollIntoView({ block: 'nearest' });
    } else input.removeAttribute('aria-activedescendant');
  }

  // Only addresses with a tax lot: a street or a neighborhood has no building to report on.
  async function updateSuggestions() {
    const text = input.value.trim();
    suggestAbort?.abort();
    if (text.length < 3 || /^\d+$/.test(text)) { renderOptions([]); return; }
    suggestAbort = new AbortController();
    try {
      const places = await suggest(text, { signal: suggestAbort.signal });
      renderOptions(places.filter((p: any) => isBbl(p.bbl)).map((p: any) => ({ label: p.label, bbl: p.bbl })));
    } catch (err: any) {
      if (err.name !== 'AbortError') renderOptions([]); // typing still works; submitting looks it up
    }
  }

  input.addEventListener('input', () => {
    clearTimeout(timer);
    status.textContent = '';
    timer = window.setTimeout(updateSuggestions, 250);
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' && options.length) { e.preventDefault(); highlightOption(Math.min(active + 1, options.length - 1)); }
    else if (e.key === 'ArrowUp' && options.length) { e.preventDefault(); highlightOption(Math.max(active - 1, -1)); }
    else if (e.key === 'Enter' && active >= 0) { e.preventDefault(); pick(options[active]); }
    else if (e.key === 'Escape' && options.length) { e.preventDefault(); closeOptions(); }
  });
  // mousedown so the input keeps focus (a click would blur it first and close the list).
  list.addEventListener('mousedown', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
    if (!li) return;
    e.preventDefault();
    pick(options[Number(li.dataset.i)]);
  });
  input.addEventListener('blur', () => setTimeout(closeOptions, 150));

  function pick(o: Option) {
    input.value = o.label;
    closeOptions();
    status.textContent = 'Opening the report…';
    go(o.bbl);
  }

  async function search() {
    closeOptions();
    choices.hidden = true;
    const id = ++lookup;
    status.textContent = 'Looking up that address…';
    let result: any;
    try {
      result = await findBuilding(parseLocationInput({ text: input.value }));
    } catch {
      if (id === lookup) status.textContent = 'Couldn’t reach the address lookup. Try again in a minute.';
      return;
    }
    if (id !== lookup) return;
    if (result.status === 'resolved') { status.textContent = 'Opening the report…'; go(result.place.bbl); return; }
    if (result.status === 'need-address') { status.textContent = result.text; input.focus(); return; }
    if (result.status === 'not-found') { status.textContent = 'No matching NYC address. Check the house number and street, or add the borough.'; return; }
    status.textContent = result.reason === 'ambiguous' ? 'That address is in more than one borough. Which one?' : 'No exact match. Did you mean one of these?';
    choices.innerHTML = result.suggestions.map((p: any) =>
      `<a class="pay-chip" href="${buildingPath(p.bbl)}">${escape(p.label)}</a>`).join('');
    choices.hidden = false;
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); search(); });

  // Without JavaScript the form submits ?q=; with it, an address handed over that way is looked up here.
  const handed = new URLSearchParams(location.search).get('q');
  if (handed && !lot) {
    input.value = handed.slice(0, input.maxLength);
    search();
  }
</script>

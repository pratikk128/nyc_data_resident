---
/*
 * "Map: where complaints happen near you". A heat map of requests within
 * ½ mile, with the ¼ mile outlined, and a filter for the area's top complaint
 * types. The drawing and data loading are in src/lib/complaints311/heatmap.js.
 */
---

<section class="dash-section c311-map" id="map" aria-labelledby="map-title" data-heatmap hidden>
  <header class="section-head">
    <h2 id="map-title">Map: where complaints happen near you</h2>
    <p class="section-intro">A heat map of where requests were made within ½ mile, with your ¼ mile outlined. Brighter means more requests.</p>
  </header>

  <fieldset class="c311-map-filter" data-heatmap-filter hidden>
    <legend class="filter-label">Show complaint types</legend>
    <div class="c311-chips" data-heatmap-options></div>
  </fieldset>
  <p class="field-hint" role="status" aria-live="polite" data-heatmap-status></p>

  <!-- role="region", not "img": "img" would hide Leaflet's zoom buttons from screen readers. -->
  <div class="c311-map-frame" data-heatmap-canvas role="region" aria-label="Heat map of 311 requests within ½ mile" aria-describedby="map-note"></div>
  <div class="c311-map-legend" aria-hidden="true">
    <span>Fewer requests</span><span class="c311-map-ramp"></span><span>More</span>
    <span class="c311-map-key"><span class="c311-map-key-ring"></span>¼ mile</span>
    <span class="c311-map-key"><span class="c311-map-key-ring outer"></span>½ mile</span>
  </div>
  <p class="field-hint" id="map-note">The lists above cover the same requests. A small share of requests have no location and aren’t on the map.</p>
</section>

<script>
  import { subscribe } from '../../lib/complaints311/store.js';
  import { mountHeatmap } from '../../lib/complaints311/heatmap.js';
  import { topTypes } from '../../lib/complaints311/stats.js';
  import { RADII } from '../../lib/complaints311/config.js';

  const root = document.querySelector<HTMLElement>('[data-heatmap]')!;
  const map = mountHeatmap(root);
  let selectedTypes: string[] = [];
  let shownFor: unknown = null;

  subscribe((s) => {
    const nb = s.neighborhood;
    if (!s.location || s.location.kind === 'borough') { shownFor = null; map.update(null); return; }
    if (nb.status !== 'ready' || nb.data === shownFor) return;
    shownFor = nb.data;
    const complaintTypes = topTypes(nb.data.types, 10).map((t) => t.key);
    selectedTypes = selectedTypes.filter((k) => complaintTypes.includes(k));
    map.update({
      center: nb.data.center,
      radiusMeters: RADII.neighborhood,
      window: nb.data.window,
      dateRange: { since: nb.data.since, through: nb.data.through },
      complaintTypes,
      selectedTypes,
      onComplaintTypeChange: (selected: string[]) => { selectedTypes = selected; }
    });
  });
</script>

---
/*
 * Section B, "Performance over time": for one report, a chart per curated
 * metric over every school year (drawn by src/lib/schools/charts.js from the
 * page's JSON) with the trend over the last 3 years, and the numbers, NYC
 * average, similar schools and DOE rating as a table (rendered here, so they
 * read without script).
 */
import { REPORTS, yearLabel } from '../../lib/schools/config.js';
import { METRICS } from '../../lib/schools/metrics.js';
import { formatValue, gapYears, trendSentence, targetBand } from '../../lib/schools/values.js';
import { trendChip } from '../../lib/schools/render.js';

interface Props {
  report: any;      // one of schoolDetail().reports
  multiple: boolean;
}
const { report, multiple } = Astro.props;
type ReportKey = keyof typeof REPORTS; // report is untyped, so its report code needs this to index REPORTS
const byId = Object.fromEntries(METRICS.map((m) => [m.id, m]));
const years: number[] = report.years;
const charts = report.metrics.map((entry: any) => {
  const metric = byId[entry.id];
  const gaps = gapYears(entry.points, years);
  const scored = years.some((y) => entry.points[y]?.score != null);
  return { entry, metric, gaps, scored };
});
const gapNotes = [...new Map(charts.flatMap((c: any) => c.gaps).map((g: any) => [g.year, g])).values()]
  .sort((a: any, b: any) => a.year - b.year);
const id = `trends-${report.report.toLowerCase()}`;
const hasCity = (entry: any) => years.some((y) => entry.city?.[y] != null);
const hasSimilar = (entry: any) => years.some((y) => entry.points[y]?.cmp != null);
---

<section class="dash-section sq-trends" aria-labelledby={`${id}-title`} id={id}>
  <div class="section-head">
    <h2 id={`${id}-title`}>
      Performance over time{multiple && <span class="sq-head-report"> {REPORTS[report.report as ReportKey].label} grades</span>}
    </h2>
    <p class="section-intro">
      For a closer look: each measure from {yearLabel(years[0])} to {yearLabel(years[years.length - 1])}. Point at a
      year for its numbers and DOE rating.
    </p>
    <ul class="legend sq-legend" aria-hidden="true">
      <li><span class="swatch sq-swatch-school"></span>This school</li>
      <li><span class="swatch sq-swatch-city"></span>NYC average for {REPORTS[report.report as ReportKey].plural}</li>
    </ul>
  </div>

  {gapNotes.length > 0 && (
    <div class="callout callout-heads-up sq-gap-callout">
      <p><strong>Heads up:</strong> some years are blank, and the charts leave a shaded gap instead of drawing across them.</p>
      <ul class="caveats">
        {gapNotes.map((g: any) => <li><strong>{yearLabel(g.year)}:</strong> {g.reason}</li>)}
      </ul>
    </div>
  )}

  <div class="sq-charts">
    {charts.map(({ entry, metric, gaps, scored }: any) => (
      <figure class="sq-chart-card" data-chart={entry.id} data-report={report.report}>
        <div class="sq-chart-head">
          <h3 class="sq-chart-title">{metric.label}</h3>
          {!metric.context && <p class="sq-chart-trend"><Fragment set:html={trendChip(metric, entry.trend)} /></p>}
        </div>
        <p class="sq-chart-sentence">{metric.context ? 'Context, not a sign of quality.' : trendSentence(metric, entry.trend)}</p>
        <div class="chart sq-chart">
          <noscript><p class="chart-fallback">The chart needs JavaScript. The numbers are in the table below.</p></noscript>
          <div class="chart-tooltip" hidden></div>
          <p class="sr-only chart-live" aria-live="polite"></p>
        </div>
        <p class="chart-hint sq-axis-note" hidden></p>
        {metric.seriesBreak && years.includes(metric.seriesBreak.year) && years[0] < metric.seriesBreak.year && (
          <p class="chart-hint"><strong>New measure:</strong> {metric.seriesBreak.note}</p>
        )}

        <details class="sq-table-toggle">
          <summary>View as table</summary>
          <div class="table-scroll">
            <table>
              <caption class="sr-only">{metric.label} by school year</caption>
              <thead>
                <tr>
                  <th scope="col">School year</th>
                  <th scope="col">This school</th>
                  {hasCity(entry) && <th scope="col">NYC average</th>}
                  {hasSimilar(entry) && <th scope="col">Similar schools</th>}
                  {scored && <th scope="col">DOE rating</th>}
                </tr>
              </thead>
              <tbody>
                {years.map((y) => {
                  const p = entry.points[y];
                  const gap = gaps.find((g: any) => g.year === y);
                  return (
                    <tr>
                      <th scope="row">{yearLabel(y)}</th>
                      <td title={gap?.reason}>{formatValue(metric, p?.v ?? null)}</td>
                      {hasCity(entry) && <td>{entry.city?.[y] != null ? formatValue(metric, entry.city[y]) : '–'}</td>}
                      {hasSimilar(entry) && <td>{p?.cmp != null ? formatValue(metric, p.cmp) : '–'}</td>}
                      {scored && <td>{targetBand(p?.score ?? null)?.label ?? '–'}</td>}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </details>
      </figure>
    ))}
  </div>
</section>

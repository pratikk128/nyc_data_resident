---
/*
 * Section A, "How is this school doing now?": for one report's latest year,
 * first a summary of which measures are better, about the same or worse than
 * the NYC average, then one tile per curated metric with the value, that call,
 * how far from the NYC average and the trend. The description, similar
 * schools and DOE's target rating sit behind "More about this measure".
 * Context metrics (student count) are a line of text, not a tile.
 */
import { REPORTS, TYPE_BY_SLUG, yearLabel } from '../../lib/schools/config.js';
import { METRICS } from '../../lib/schools/metrics.js';
import { formatValue, compare, verdict, trendSentence, latestYearWithValue } from '../../lib/schools/values.js';
import { bandBadge, trendChip, vsCityText, verdictPill, VERDICTS } from '../../lib/schools/render.js';

interface Props {
  report: any;      // one of schoolDetail().reports
  multiple: boolean; // the school has more than one report
  newest: number;    // the school's newest report year; an older report is labeled as past
  current: boolean;  // the school has a report for the newest year in the dataset
}
const { report, multiple, newest, current } = Astro.props;
type ReportKey = keyof typeof REPORTS; // report is untyped, so its report code needs this to index REPORTS
// The NYC average is per school type: "middle schools", not "elementary and middle schools".
const peers = TYPE_BY_SLUG[report.type]?.plural ?? REPORTS[report.report as ReportKey].plural;
const past = report.year < newest;
const heading = past ? `Its last ${REPORTS[report.report as ReportKey].noun} report`
  : current ? 'How is this school doing now?' : 'How was this school doing in its last report?';
const byId = Object.fromEntries(METRICS.map((m) => [m.id, m]));
const year = report.year;
const id = `now-${report.report.toLowerCase()}`;
const tiles = report.metrics.map((entry: any) => {
  const metric = byId[entry.id];
  const point = entry.points[year] ?? null;
  const v = point?.v ?? null;
  const lastYear = v == null ? latestYearWithValue(entry.points) : null;
  const similar = point?.cmp != null ? compare(metric, v, point.cmp) : null;
  return {
    metric, v, point, entry,
    anchor: `${id}-${entry.id}`,
    last: lastYear != null ? { year: lastYear, text: formatValue(metric, entry.points[lastYear].v) } : null,
    vsCity: v == null ? '' : vsCityText(metric, v, entry.city?.[year]),
    vsSimilar: similar ? (similar.dir === 'same' ? `Same as similar schools (${formatValue(metric, point.cmp)})` : `${similar.text} similar schools (${formatValue(metric, point.cmp)})`) : '',
    verdict: verdict(metric, v, entry.city?.[year])
  };
});
// "Last 3 years" only when the trend's years are the 3 up to this report;
// otherwise their span, so an old trend (a measure not reported this year) doesn't read as current.
function trendLabel(t: any) {
  const ys: number[] = t?.years ?? [];
  if (!t?.dir || (ys[ys.length - 1] === year && ys[ys.length - 1] - ys[0] === ys.length - 1)) return 'Last 3 years:';
  return `${yearLabel(ys[0])} to ${yearLabel(ys[ys.length - 1])}:`;
}
const quality = tiles.filter((t: any) => !t.metric.context);
const context = tiles.filter((t: any) => t.metric.context && t.v != null);
const groups = (['better', 'similar', 'worse'] as const).map((key) => ({
  key, ...VERDICTS[key], tiles: quality.filter((t: any) => t.verdict === key)
}));
const judged = groups.reduce((n, g) => n + g.tiles.length, 0);
---

<section class="dash-section sq-now" aria-labelledby={`${id}-title`} id={id}>
  <div class="section-head">
    <h2 id={`${id}-title`}>
      {heading}
      {multiple && !past && <span class="sq-head-report"> {REPORTS[report.report as ReportKey].label} grades</span>}
    </h2>
    <p class="section-intro">
      Each measure from the school’s {yearLabel(year)} report{past && <>, its last one of this kind</>}, next to the
      average for NYC {peers}.
    </p>
  </div>

  {judged > 0 && (
    <div class="sq-summary-wrap">
      <h3 class="sq-summary-title" id={`${id}-glance`}>
      Where this school is better or worse than the average for NYC {peers}
    </h3>
    <ul class="sq-summary" aria-labelledby={`${id}-glance`}>
      {groups.map((g) => (
        <li class="sq-summary-group" data-verdict={g.key}>
          <p class="sq-summary-label">{g.group}</p>
          <p class="sq-summary-count">
            {g.tiles.length}<span class="sq-summary-of"> of {judged} {judged === 1 ? 'measure' : 'measures'}</span>
          </p>
          {g.tiles.length > 0 ? (
            <ul class="sq-summary-list">
              {g.tiles.map((t: any) => <li><a href={`#${t.anchor}`}>{t.metric.label}</a></li>)}
            </ul>
          ) : <p class="sq-summary-list">None</p>}
        </li>
      ))}
    </ul>
    </div>
  )}

  {quality.length ? (
    <ul class="sq-tiles">
      {quality.map((t: any) => (
        <li class="sq-tile" id={t.anchor} data-verdict={t.verdict ?? 'none'}>
          <p class="sq-tile-label">{t.metric.label}</p>
          <p class={`sq-tile-value${t.v == null ? ' is-missing' : ''}`}>{formatValue(t.metric, t.v)}</p>
          {t.verdict && <p class="sq-tile-verdict" set:html={verdictPill(t.verdict)} />}
          {t.vsCity && <p class="sq-tile-vs">{t.vsCity}</p>}
          {t.last && <p class="sq-tile-vs">Last reported: {t.last.text} in {yearLabel(t.last.year)}</p>}
          <p class="sq-tile-trend">
            <span class="sq-tile-trend-label">{trendLabel(t.entry.trend)}</span>
            <Fragment set:html={trendChip(t.entry.trend)} />
            {t.entry.trend?.dir && <span class="sr-only"> {trendSentence(t.metric, t.entry.trend)}</span>}
          </p>
          <details class="sq-tile-more">
            <summary>More about this measure</summary>
            <p>{t.metric.description}</p>
            {t.vsSimilar && <p>{t.vsSimilar}.</p>}
            {t.point?.score != null && <p>DOE rating: <Fragment set:html={bandBadge(t.point.score)} /></p>}
          </details>
        </li>
      ))}
    </ul>
  ) : (
    <p class="sq-none">This report has none of the measures we track for {peers}.</p>
  )}

  {context.map((t: any) => (
    <p class="sq-context">
      <strong>{t.metric.label}: {formatValue(t.metric, t.v)}.</strong> {t.metric.description} Context, not a sign of quality.
    </p>
  ))}
</section>

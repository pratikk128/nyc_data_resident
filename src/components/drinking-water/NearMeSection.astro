---
/*
 * "What about near me?": search an address or ZIP, or use the browser's
 * location, for the 3 nearest stations; or browse a borough and pick stations. Each picked station gets a card with any
 * bacteria found over 12 months, a chlorine sparkline against the citywide
 * median, and a one-line cloudiness comparison. The station list (from src/data/water-sites.json,
 * only stations sampled in the last 12 months) is inlined; the card data
 * comes from /api/water/stations. State lives in the URL:
 *   ?boro=QUEENS&sites=79150,79450&zip=11211         a ZIP search
 *   ?boro=QUEENS&sites=79150,79450&lat=40.692&lon=-73.761   an address search
 * An address itself never goes in the URL (it would sit in browser history and
 * in shared links): only its spot, rounded to about a block.
 */
import { BOROUGHS, NEAREST_COUNT, MAX_SELECTED, ERROR_TEXT } from '../../lib/water/config.js';
import { monthLabel } from '../../lib/water/stats.js';

interface Props {
  stations: { site: string; place: string; borough: string | null; lat: number; lon: number }[];
  months: string[];
  error: boolean;
}
const { stations, months, error } = Astro.props;
const range = months.length ? `${monthLabel(months[0], 'short')}–${monthLabel(months[months.length - 1], 'short')}` : '';
---

<section class="dash-section" id="near-me" aria-labelledby="near-title"
  data-near-me data-stations={JSON.stringify(stations)} data-range={range}>
  <header class="section-head">
    <h2 id="near-title">What about near me?</h2>
    <p class="section-intro">
      Search your address to see the 3 nearest sampling stations and their last 12 months{range && <> ({range})</>}.
    </p>
  </header>

  {error ? (
    <p class="callout callout-heads-up" role="alert">{ERROR_TEXT}</p>
  ) : (
    <>
      <form class="water-search" data-search novalidate>
        <div class="field">
          <label class="filter-label water-search-label" for="water-q">Your address or ZIP code</label>
          <input class="search-input" id="water-q" name="q" type="search" autocomplete="street-address"
            placeholder="Try 350 5th Ave, or 11211" maxlength="120" aria-describedby="water-q-hint" />
          <span class="field-hint" id="water-q-hint">We'll pick the {NEAREST_COUNT} nearest stations.</span>
        </div>
        <div class="water-search-btns">
          <button class="near-btn water-go water-go-primary" type="submit">Find nearest</button>
          <button class="near-btn water-go" type="button" data-locate>Use my location</button>
        </div>
      </form>

      <fieldset class="water-browse">
        <legend class="water-browse-legend">Or browse by borough</legend>
        <div class="field">
          <label class="filter-label" for="water-boro">Borough</label>
          <select class="filter-select" id="water-boro" name="boro">
            <option value="">All boroughs</option>
            {BOROUGHS.map((b) => <option value={b.value}>{b.label}</option>)}
          </select>
        </div>
        <div class="field">
          <label class="filter-label" for="water-station">Add a station</label>
          <select class="filter-select" id="water-station" name="station" aria-describedby="water-station-hint">
            <option value="">Pick a station…</option>
          </select>
          <span class="field-hint" id="water-station-hint">Up to {MAX_SELECTED} at a time. You can also tap a dot on the map.</span>
        </div>
      </fieldset>

      <div class="water-suggest" data-suggest hidden></div>
      <p class="rest-status" role="status" aria-live="polite" data-status></p>

      <div class="c311-map-frame water-map" data-map role="region" aria-label="Map of drinking water sampling stations"></div>
      <div class="c311-map-legend water-map-legend" aria-hidden="true">
        <span class="water-key"><span class="water-key-dot"></span>Sampling station</span>
        <span class="water-key"><span class="water-pin water-pin-inline"><span>1</span></span>Picked station</span>
        <span class="water-key"><span class="water-key-you"></span>Your search</span>
      </div>

      <div class="water-cards" data-cards></div>
      <p class="water-empty" data-empty>
        No stations picked yet. Search an address or ZIP, use your location, or browse by borough. The pigeons are
        standing by.
      </p>
      <p class="chart-hint" data-spark-hint hidden>
        Chlorine lines: this station (solid) vs. citywide (dashed). Each month is only a few samples, so small wiggles
        are normal.
      </p>
    </>
  )}
</section>

<script>
  import { mountStationMap } from '../../lib/water/station-map.js';
  import { stationCardHtml, cardSkeletonHtml, escape } from '../../lib/water/near-me.js';
  import { drawSparkline } from '../../lib/water/charts.js';
  import { nearestSites } from '../../lib/water/stats.js';
  import { BOROUGHS, NEAREST_COUNT, MAX_SELECTED, ERROR_TEXT, boroughLabel } from '../../lib/water/config.js';
  import { parseLocationInput } from '../../lib/complaints311/location-input.js';
  import { inCityLimits } from '../../lib/in-city.js';
  import { resolveLocation } from '../../lib/complaints311/geocode.js';
  import zipFile from '../../data/zip-centroids.json';

  type Station = { site: string; place: string; borough: string | null; lat: number; lon: number; miles?: number };
  type Point = { lat: number; lon: number; label: string; zip?: string };

  const root = document.querySelector<HTMLElement>('[data-near-me]');
  const form = root?.querySelector<HTMLFormElement>('[data-search]');

  if (root && form) {
    const stations: Station[] = JSON.parse(root.dataset.stations!);
    const bySite = new Map(stations.map((s) => [s.site, s]));
    const input = form.querySelector<HTMLInputElement>('#water-q')!;
    const boroSelect = root.querySelector<HTMLSelectElement>('#water-boro')!;
    const stationSelect = root.querySelector<HTMLSelectElement>('#water-station')!;
    const locateBtn = form.querySelector<HTMLButtonElement>('[data-locate]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const suggest = root.querySelector<HTMLElement>('[data-suggest]')!;
    const cards = root.querySelector<HTMLElement>('[data-cards]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const sparkHint = root.querySelector<HTMLElement>('[data-spark-hint]')!;
    const map = mountStationMap(root.querySelector<HTMLElement>('[data-map]')!, { onPick: (site: string) => add(site) });

    let borough = '';
    let selected: string[] = [];
    let point = null as Point | null; // set by readUrl, which TypeScript doesn't follow
    let request = 0;
    let lookup = 0; // bumped by every redraw, so a slow address lookup can't undo a later pick
    const cache = new Map<string, any>(); // site → details, plus the shared context
    const loading = new Map<string, Promise<void>>(); // site → its fetch in flight
    let context: any = null;

    // ---------- URL ----------
    function readUrl() {
      const p = new URLSearchParams(location.search);
      borough = BOROUGHS.some((b) => b.value === p.get('boro')) ? p.get('boro')! : '';
      selected = (p.get('sites') ?? '').split(',').filter((s) => bySite.has(s)).slice(0, MAX_SELECTED);
      const zip = p.get('zip') ?? '';
      const c = (zipFile.zips as Record<string, number[]>)[zip];
      const lat = Number(p.get('lat')), lon = Number(p.get('lon'));
      point = c ? { lat: c[0], lon: c[1], label: `ZIP ${zip}`, zip }
        : p.get('lat') && Number.isFinite(lat) && Number.isFinite(lon) && inCityLimits(lat, lon)
          ? { lat, lon, label: 'your search' } : null;
    }
    // 3 decimals is about 100 m: enough for the distances and the map dot.
    const round = (v: number) => String(Math.round(v * 1000) / 1000);
    function writeUrl() {
      const p = new URLSearchParams();
      if (borough) p.set('boro', borough);
      if (selected.length) p.set('sites', selected.join(','));
      if (point?.zip) p.set('zip', point.zip);
      else if (point) { p.set('lat', round(point.lat)); p.set('lon', round(point.lon)); }
      const query = p.toString();
      history.replaceState(null, '', query ? `?${query}` : location.pathname);
    }

    // ---------- Drawing ----------
    function fillStationSelect() {
      const list = stations.filter((s) => !borough || s.borough === borough)
        .sort((a, b) => a.place.localeCompare(b.place));
      stationSelect.innerHTML = `<option value="">Pick a station… (${list.length})</option>` +
        list.map((s) => `<option value="${escape(s.site)}"${selected.includes(s.site) ? ' disabled' : ''}>` +
          `${escape(s.place)} (${escape(s.site)})${borough ? '' : ` · ${escape(boroughLabel(s.borough))}`}</option>`).join('');
    }

    // The map zooms only when the search or borough changes, not on every pick.
    let fitKey: string | null = null;
    function drawMap() {
      const shown = stations.filter((s) => !borough || s.borough === borough || selected.includes(s.site));
      const key = point ? `${point.lat},${point.lon}` : borough;
      map.update({ stations: shown, selected, point, refit: key !== fitKey });
      fitKey = key;
    }

    function withDistance(s: Station): Station {
      return point ? { ...s, miles: nearestSites([s], point, 1)[0]?.miles } : s;
    }

    // Fetches the sites not already on their way, then waits for all of them.
    function load(sites: string[]) {
      const fresh = sites.filter((s) => !loading.has(s));
      if (fresh.length) {
        const done = (async () => {
          const res = await fetch(`/api/water/stations?sites=${encodeURIComponent(fresh.join(','))}`);
          const data = await res.json().catch(() => null);
          if (!res.ok || !data?.stations) throw new Error(res.status === 400 && data?.error ? data.error : 'upstream');
          context = { months: data.months, city: data.city, cityTotals: data.cityTotals };
          for (const [site, d] of Object.entries(data.stations)) cache.set(site, d);
        })().finally(() => fresh.forEach((s) => loading.delete(s)));
        fresh.forEach((s) => loading.set(s, done));
      }
      return Promise.all(sites.map((s) => loading.get(s)));
    }

    // message: shown in the status line instead of the usual "Showing N stations."
    async function drawCards(message = '') {
      const id = ++request;
      empty.hidden = selected.length > 0;
      sparkHint.hidden = true;
      if (!selected.length) { cards.innerHTML = ''; status.textContent = message; return; }
      const missing = selected.filter((s) => !cache.has(s));
      if (missing.length) {
        cards.setAttribute('aria-busy', 'true');
        cards.innerHTML = selected.map(() => cardSkeletonHtml()).join('');
        status.textContent = 'Pulling up the station results…';
        try {
          await load(missing);
        } catch (err: any) {
          if (id !== request) return;
          cards.setAttribute('aria-busy', 'false');
          status.textContent = '';
          cards.innerHTML = `<p class="c311-error" role="alert">${escape(err.message !== 'upstream' ? err.message : ERROR_TEXT)}` +
            ` <button type="button" class="near-btn water-retry" data-retry>Try again</button></p>`;
          return;
        }
        if (id !== request) return;
      }
      cards.setAttribute('aria-busy', 'false');
      status.textContent = message || (point
        ? `The ${selected.length} ${selected.length === 1 ? 'station' : 'stations'} nearest ${point.label}.`
        : `Showing ${selected.length} ${selected.length === 1 ? 'station' : 'stations'}.`);
      cards.innerHTML = selected.map((site, index) =>
        stationCardHtml(withDistance(bySite.get(site)!), cache.get(site), { ...context, index })).join('');
      cards.querySelectorAll<HTMLElement>('.water-card').forEach((card, i) => {
        const d = cache.get(selected[i]);
        if (!d?.totals?.n) return;
        const slot = card.querySelector<HTMLElement>('[data-spark="cl"]');
        if (!slot) return;
        const values = d.series.map((m: any) => m?.clMed ?? null);
        const cityValues = context.city.map((m: any) => m?.clMed ?? null);
        const listed = values.map((v: number | null, j: number) => `${context.months[j]}: ${v ?? 'no samples'}`).join(', ');
        drawSparkline(slot, values, cityValues, {
          fmt: (v: number) => String(+v.toFixed(2)),
          label: `Monthly median chlorine at station ${selected[i]}, in mg/L: ${listed}.`
        });
      });
      sparkHint.hidden = !cards.querySelector('[data-spark] svg');
    }

    function render(message = '') {
      lookup++;
      boroSelect.value = borough;
      fillStationSelect();
      drawMap();
      drawCards(message);
      writeUrl();
    }

    // ---------- Actions ----------
    function add(site: string) {
      if (!bySite.has(site) || selected.includes(site)) return;
      if (selected.length >= MAX_SELECTED) {
        // Never drop a picked station silently; ask for a removal instead.
        stationSelect.value = '';
        status.textContent = `You can compare up to ${MAX_SELECTED} stations. Remove one to add station ${site}.`;
        return;
      }
      selected = [...selected, site];
      render();
    }

    async function search(text: string) {
      suggest.hidden = true;
      const parsed: any = parseLocationInput({ text });
      if (parsed.kind === 'empty') { status.textContent = 'Type an address or ZIP code first.'; return; }
      if (parsed.kind === 'error') { status.textContent = parsed.message; return; }
      if (parsed.kind === 'borough') {
        borough = parsed.borough; point = null;
        render(`Showing stations in ${boroughLabel(borough)}. Pick one from the list or the map.`);
        return;
      }
      if (parsed.kind === 'zip') {
        const c = (zipFile.zips as Record<string, number[]>)[parsed.zip];
        if (!c) { status.textContent = `We don’t have a location for ZIP ${parsed.zip}. Try an address in it.`; return; }
        usePoint({ lat: c[0], lon: c[1], label: `ZIP ${parsed.zip}`, zip: parsed.zip });
        return;
      }
      status.textContent = 'Looking up that address…';
      const id = ++lookup;
      let result: any;
      try {
        result = await resolveLocation(parsed);
      } catch {
        if (id !== lookup) return;
        status.textContent = 'Couldn’t reach the address lookup. Try again in a minute, or pick a borough instead.';
        return;
      }
      if (id !== lookup) return;
      if (result.status === 'resolved') { usePoint(result.location); return; }
      if (result.status === 'choose') {
        status.textContent = result.reason === 'ambiguous' ? 'That could be a few places. Which one?' : 'No exact match. Did you mean one of these?';
        suggest.innerHTML = result.suggestions.map((p: any, i: number) =>
          `<button type="button" class="pay-chip" data-pick="${i}">${escape(p.label)}</button>`).join('');
        suggest.hidden = false;
        suggest.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => b.addEventListener('click', () => {
          const p = result.suggestions[Number(b.dataset.pick)];
          suggest.hidden = true;
          usePoint({ lat: p.lat, lon: p.lon, label: p.label });
        }));
        return;
      }
      status.textContent = 'No matches. Try a nearby ZIP code or fewer words.';
    }

    function usePoint(p: Point) {
      point = { lat: p.lat, lon: p.lon, label: p.label, zip: p.zip };
      const near: Station[] = nearestSites(stations, point, NEAREST_COUNT);
      selected = near.map((s) => s.site);
      borough = near[0]?.borough ?? '';
      render();
    }

    form.addEventListener('submit', (e) => { e.preventDefault(); search(input.value); });
    locateBtn.addEventListener('click', () => {
      suggest.hidden = true;
      if (!navigator.geolocation) { status.textContent = 'Your browser can’t share its location. Type an address or ZIP code instead.'; return; }
      const id = ++lookup;
      locateBtn.disabled = true;
      status.textContent = 'Finding you…';
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          locateBtn.disabled = false;
          if (id !== lookup) return;
          const { latitude: lat, longitude: lon } = pos.coords;
          if (!inCityLimits(lat, lon)) { status.textContent = 'You seem to be outside NYC. Type an address or ZIP code instead.'; return; }
          input.value = '';
          usePoint({ lat, lon, label: 'your location' });
        },
        () => {
          locateBtn.disabled = false;
          if (id !== lookup) return;
          status.textContent = 'We couldn’t get your location. Check your browser’s location setting, or type an address or ZIP code.';
        },
        { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 }
      );
    });
    boroSelect.addEventListener('change', () => {
      borough = boroSelect.value;
      point = null;
      render();
    });
    stationSelect.addEventListener('change', () => { if (stationSelect.value) add(stationSelect.value); });
    cards.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const remove = target.closest<HTMLElement>('[data-remove]');
      if (remove) {
        selected = selected.filter((s) => s !== remove.dataset.remove);
        if (!selected.length) point = null;
        render();
        stationSelect.focus();
      }
      if (target.closest('[data-retry]')) drawCards();
    });

    readUrl();
    if (point?.zip) input.value = point.zip;
    render();
  }
</script>

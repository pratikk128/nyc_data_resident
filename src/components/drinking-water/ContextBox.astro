---
/*
 * "What this doesn't cover": the limits of street-side samples, and what to
 * do about lead. Shown after the results, never collapsed, on every view.
 */
import { LINKS } from '../../lib/water/config.js';
---

<aside class="callout callout-good water-context" aria-labelledby="water-context-title">
  <h2 class="water-context-title" id="water-context-title">What this doesn't cover</h2>
  <ul>
    <li>
      These samples come from street-side stations on city mains, not your tap. Water inside a building can differ.
    </li>
    <li>
      Lead usually comes from building pipes and fixtures, not city mains. Get a free lead test kit by calling 311 or
      <a href={LINKS.leadKit}>ordering one from NYC DEP</a>.
    </li>
  </ul>
</aside>

---
/*
 * "Is my water safe right now?": a report card for the latest full month,
 * then a short look back since 2015 (HistorySection). Rendered on the server
 * from the daily monthly and detections jobs (src/lib/server/water.js).
 */
import HistorySection from './HistorySection.astro';
import { reportCard, verdict, monthLabel, hasEcoli, isResample, resampleEcoli, ecoliAgain, followUpText, isStale, monthAge, STATUS_TEXT, STATUS_ICON as ICON } from '../../lib/water/stats.js';
import { boroughLabel, ERROR_TEXT, RESAMPLE_NOTE, LINKS } from '../../lib/water/config.js';
import { SITES, siteDescription } from '../../lib/water/sites.js';
import { measurementText } from '../../lib/water/parse.js';
import { count, date, nycToday } from '../../lib/format.js';

interface Props {
  monthly: any | null;
  detections: any | null;
  error: boolean;
  /** The detections job failed: the E. coli table and chart markers are missing. */
  detectionsError: boolean;
}
const { monthly, detections, error, detectionsError } = Astro.props;
// stats.js is plain JS, so its statuses come through as strings.
type Status = keyof typeof ICON;

const month = monthly?.completeMonth ? monthly.months.find((m: any) => m.month === monthly.completeMonth) : null;
const ecoliAll = (detections?.detections ?? []).filter(hasEcoli);
const ecoliThisMonth = month ? ecoliAll.filter((d: any) => d.date.startsWith(month.month)) : [];
// The tiles count routine samples; resample positives are listed below, so the E. coli tile counts them too.
// E. coli again at the same station within 14 days turns it red.
const tiles = month ? reportCard(month, { resampleEcoli: resampleEcoli(ecoliThisMonth).length, ecoliAgain: ecoliThisMonth.some(ecoliAgain) }) : [];
const headline = month ? verdict(tiles) : null;
// Newest first; months after the report card's are still loading and left out of the history it links to.
const lastEcoli = month ? ecoliAll.find((d: any) => d.date.slice(0, 7) <= month.month) ?? null : null;
// Months after the report card's that are still loading, left out of the history.
const loading: string[] = month ? monthly.months.map((m: any) => m.month).filter((k: string) => k > month.month) : [];
const ecoliLoading = ecoliAll.filter((d: any) => d.date.slice(0, 7) > (month?.month ?? '9999'));
const lastEcoliBorough = lastEcoli ? SITES.get(lastEcoli.site)?.borough : null;
// DEP hasn't posted a newer full month in a while: "right now" is older than it looks.
const today = nycToday();
const stale = month ? isStale(month.month, today) : false;
---

<section class="dash-section" id="now" aria-labelledby="now-title">
  <header class="section-head">
    <h2 id="now-title">{stale ? 'Is my water safe? These results are old' : 'Is my water safe right now?'}</h2>
    {month && (
      <p class="water-asof" data-stale={stale ? '' : undefined}>
        Latest full month: <strong>{monthLabel(month.month)}</strong> ({monthAge(month.month, today)}).
        {monthly.latestDate && <> Newest sample in the data: {date(monthly.latestDate)}.</>}
      </p>
    )}
  </header>

  {error && (
    <p class="callout callout-heads-up" role="alert">{ERROR_TEXT}</p>
  )}

  {!error && !month && (
    <p class="water-empty">No full month of samples in the data yet. Even the pigeons are waiting. Check back soon.</p>
  )}

  {month && (
    <>
      {stale && (
        <p class="callout callout-heads-up" role="alert">
          <strong>Heads up: these results are from {monthLabel(month.month)}, {monthAge(month.month, today)}.</strong> NYC usually posts each month's
          samples within a few weeks, but nothing newer than {monthLabel(month.month)} has arrived
          {monthly.latestDate && <> (the newest sample is from {date(monthly.latestDate)})</>}. Today's water could
          differ. For the city's official word, see <a href={LINKS.annualReport}>DEP's annual water quality report</a>.
        </p>
      )}

      <div class="water-verdict" data-status={headline!.status}>
        <p class="water-verdict-title">
          <span class="water-status-icon" aria-hidden="true">{ICON[headline!.status as Status]}</span>
          {headline!.title} in {monthLabel(month.month)}
        </p>
        <p>
          {headline!.sentence} Based on {count(month.n)} samples from {count(month.sites)} street-side stations
          across the five boroughs.
        </p>
      </div>

      <ul class="water-tiles" aria-label={`Report card for ${monthLabel(month.month)}`}>
        {tiles.map((t) => (
          <li class="water-tile" data-status={t.status}>
            <p class="water-tile-status">
              <span class="water-status-icon" aria-hidden="true">{ICON[t.status as Status]}</span>
              {STATUS_TEXT[t.status as Status]}
            </p>
            <h3 class="water-tile-label">{t.label}</h3>
            <p class="water-tile-value">{t.value} <span class="water-tile-unit">{t.valueLabel}</span></p>
            <p class="water-tile-sentence">{t.sentence}</p>
          </li>
        ))}
      </ul>
      <p class="chart-hint">
        Colors compare samples with reference values. They're not an official compliance finding.
      </p>

      {ecoliThisMonth.length > 0 ? (
        <div class="callout callout-heads-up water-ecoli" role="note">
          <h3 class="water-h3">E. coli found in {monthLabel(month.month)}</h3>
          <div class="table-scroll" tabindex="0" role="region" aria-label={`E. coli detections in ${monthLabel(month.month)}`}>
            <table>
              <thead><tr><th scope="col">Station</th><th scope="col">Date</th><th scope="col">E. coli (MPN/100 mL)</th><th scope="col">At this station in the next 14 days</th></tr></thead>
              <tbody>
                {ecoliThisMonth.map((d: any) => (
                  <tr>
                    <th scope="row">{d.site}<span class="water-cell-sub">{siteDescription(d.site)}</span></th>
                    <td>{date(d.date)}{isResample(d.sampleClass) && <span class="water-cell-sub">Resample</span>}</td>
                    <td>{measurementText(d.ecoli)}</td>
                    <td class="water-cell-wrap">{followUpText(d)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p>{RESAMPLE_NOTE}</p>
        </div>
      ) : detectionsError && month.ecoli.pos > 0 ? (
        <p class="callout callout-heads-up water-ecoli" role="alert">
          E. coli was found in {count(month.ecoli.pos)} {month.ecoli.pos === 1 ? 'sample' : 'samples'} this month, but
          the station details didn't load from NYC Open Data. Try again in a minute.
        </p>
      ) : (
        lastEcoli && (
          <p class="water-note">
            E. coli is rare. The last detection was on {date(lastEcoli.date)}
            {lastEcoliBorough && <> in {boroughLabel(lastEcoliBorough)}</>}.{' '}
            <a href="#history">See the history since 2015</a>.
          </p>
        )
      )}

      {loading.length > 0 && (
        <p class="water-note">
          {new Intl.ListFormat('en', { type: 'conjunction' }).format(loading.map((k) => monthLabel(k)))} samples are
          still coming in, so {loading.length === 1 ? "it's" : "they're"} not in the report card or the history yet.
          {ecoliLoading.length > 0 && <> E. coli has turned up in {ecoliLoading.length} {ecoliLoading.length === 1 ? 'sample' : 'samples'} so far
            (latest {date(ecoliLoading[0].date)}).</>}
        </p>
      )}

      <HistorySection monthly={monthly} detections={detections} detectionsError={detectionsError} status={headline!.status as Status} />
    </>
  )}
</section>

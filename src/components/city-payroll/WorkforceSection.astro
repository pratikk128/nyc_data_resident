---
/*
 * "How much does NYC spend on its workforce?"
 * Headline numbers, table and notes are rendered at build time from
 * the payroll snapshot for all agencies; the stacked bar chart is drawn in
 * the browser by the script at the bottom (same data, no API calls from the
 * page). Picking an agency swaps in that agency's rows and redraws the stats,
 * chart, table and CSV link in place. The pay type checkboxes narrow the
 * total card, chart, table and CSV to regular pay, overtime and/or other pay.
 */
import StatCard from '../StatCard.astro';
import snapshot from '../../data/payroll-by-year.json';
import byAgency from '../../data/payroll-by-agency.json';
import { money, count, date } from '../../lib/format.js';
import { payrollCsvHref } from '../../lib/payroll-csv.js';

const { years, dataset, checks } = snapshot;
const latest = years[years.length - 1];
const first = years[0];
const range = `FY${first.fiscalYear}–FY${latest.fiscalYear}`;

const latestTotal = (agency) => agency.years.find((y) => y.fiscalYear === latest.fiscalYear)?.total ?? 0;
const largest = byAgency.agencies.slice().sort((a, b) => latestTotal(b) - latestTotal(a)).slice(0, 10);
---

<section class="dash-section" id="workforce" aria-labelledby="workforce-title">
  <header class="section-head">
    <h2 id="workforce-title">How much does NYC spend on its workforce?</h2>
    <p class="section-intro">
      Teachers, firefighters, sanitation crews, nurses, clerks and lifeguards all get a city paycheck.
      Here's what the city paid its people each year, and what that pay was made of.
    </p>
  </header>

  {!checks.latestYearLooksComplete && (
    <aside class="callout callout-heads-up" role="note">
      <strong>Heads up:</strong> FY{latest.fiscalYear} may not be fully loaded yet. Its numbers look low
      compared with recent years, so treat them as preliminary.
    </aside>
  )}

  <div class="filter-bar">
    <label class="filter-label" for="workforce-agency">Show payroll for</label>
    <select class="filter-select" id="workforce-agency" name="agency">
      <option value="">All agencies (citywide)</option>
      <optgroup label={`Largest payrolls, FY${latest.fiscalYear}`}>
        {largest.map((a) => <option value={a.id}>{a.label}</option>)}
      </optgroup>
      <optgroup label="All agencies, A–Z">
        {byAgency.agencies.map((a) => <option value={a.id}>{a.label}</option>)}
      </optgroup>
    </select>
    <fieldset class="pay-filter">
      <legend class="filter-label">Pay types</legend>
      <label class="pay-chip"><input type="checkbox" name="pay" value="regular" checked /><span class="swatch swatch-regular" aria-hidden="true"></span>Regular pay</label>
      <label class="pay-chip"><input type="checkbox" name="pay" value="overtime" checked /><span class="swatch swatch-overtime" aria-hidden="true"></span>Overtime</label>
      <label class="pay-chip"><input type="checkbox" name="pay" value="other" checked /><span class="swatch swatch-other" aria-hidden="true"></span>Other pay</label>
    </fieldset>
  </div>

  <p class="callout callout-heads-up" role="alert" data-agency-error hidden>
    Couldn't load agency data. Check your connection and pick the agency again.
  </p>

  <div class="stat-grid" aria-live="polite">
    <StatCard
      name="total"
      label={`Total payroll, FY${latest.fiscalYear}`}
      value={money(latest.total)}
      context="Regular pay + overtime + other pay"
    />
    <StatCard
      name="people"
      label={`People paid, FY${latest.fiscalYear}`}
      value={count(latest.peoplePaid)}
      context="Anyone paid during the year, incl. part-time and seasonal"
    />
  </div>

  <figure class="chart-frame" aria-labelledby="workforce-chart-title">
    <div class="chart-head">
      <div>
        <h3 class="chart-title" id="workforce-chart-title">Payroll by fiscal year</h3>
        <p class="chart-subtitle">
          <span data-subject>All city employees in the payroll data, {range}.</span> Dollars not adjusted for inflation.
        </p>
      </div>
      <div class="toggle" role="group" aria-label="Chart units">
        <button type="button" class="toggle-btn" data-mode="dollars" aria-pressed="true">Show as $</button>
        <button type="button" class="toggle-btn" data-mode="share" aria-pressed="false">Show as % of total</button>
      </div>
    </div>

    <ul class="legend" aria-label="Legend">
      <li data-pay="regular"><span class="swatch swatch-regular" aria-hidden="true"></span>Regular pay</li>
      <li data-pay="overtime"><span class="swatch swatch-overtime" aria-hidden="true"></span>Overtime</li>
      <li data-pay="other"><span class="swatch swatch-other" aria-hidden="true"></span>Other pay <span class="legend-note">(lump sums, differentials, retro pay)</span></li>
    </ul>

    <div class="chart" id="workforce-chart" data-chart="workforce">
      <noscript><p class="chart-fallback">Turn on JavaScript to see the chart, or open the table below.</p></noscript>
      <div class="chart-tooltip" role="status" aria-live="polite" hidden></div>
    </div>
    <p class="chart-hint">Hover or tap a bar for details. Using a keyboard? Tab to the chart, then use the arrow keys.</p>

    <div class="chart-actions">
      <details class="data-table">
        <summary>See the numbers as a table</summary>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Payroll by fiscal year, table">
          <table>
            <thead>
              <tr>
                <th scope="col">Fiscal year</th>
                <th scope="col" data-pay="regular">Regular pay</th>
                <th scope="col" data-pay="overtime">Overtime</th>
                <th scope="col" data-pay="other">Other pay</th>
                <th scope="col" data-total-head>Total</th>
                <th scope="col">People paid</th>
              </tr>
            </thead>
            <tbody data-table-body>
              {years.slice().reverse().map((y) => (
                <tr>
                  <th scope="row">FY{y.fiscalYear}</th>
                  <td data-pay="regular">{money(y.regular, 2)}</td>
                  <td data-pay="overtime">{money(y.overtime, 2)}</td>
                  <td data-pay="other">{money(y.other, 2)}</td>
                  <td>{money(y.total, 2)}</td>
                  <td>{count(y.peoplePaid)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
      <a class="download-link" href={payrollCsvHref(years)} download="nyc-payroll-by-fiscal-year.csv">Download CSV</a>
    </div>
  </figure>

  <details class="about-data">
    <summary>About this data</summary>
    <div class="about-body">
      <p>
        <strong>Fiscal years.</strong> NYC's fiscal year runs July 1 to June 30.
        FY{latest.fiscalYear} covers July 1, {latest.fiscalYear - 1} to June 30, {latest.fiscalYear}.
      </p>
      <p>
        <strong>What's in each bar.</strong> <em>Regular pay</em> is base pay for regular hours.
        <em>Overtime</em> is pay for extra hours. <em>Other pay</em> is everything else: lump sums,
        shift and other differentials, and retroactive (back) pay. Other pay can jump in years when
        back pay from new labor contracts is paid out.
      </p>
      <p>
        <strong>People paid isn't headcount.</strong> We count every pay record in the year: full-time
        and part-time staff, seasonal and per-diem workers, and people who left or retired partway
        through. Someone paid by two agencies may appear twice. On any given day, the city employs fewer
        people than this number.
      </p>
      <p>
        <strong>Agencies.</strong> Agency names come from the payroll data. The Department of Education is
        split into several payrolls (teachers, paraprofessionals, per session, and so on), and each borough's
        District Attorney is listed separately. When an agency was renamed or reorganized (for example,
        Consumer Affairs became Consumer and Worker Protection), the old and new names appear as separate
        choices.
      </p>
      <p>
        <strong>Pay, not the full cost of a worker.</strong> These totals are gross pay. They don't include
        pensions, health insurance or other benefits, which the city pays for separately.
      </p>
      <p>
        <strong>How we calculated it.</strong> We add up regular pay, overtime and other pay for every record
        in each fiscal year using the NYC Open Data API, then save the yearly totals. Negative amounts
        (refunds and corrections) are included as reported.
      </p>
    </div>
  </details>

  <footer class="section-sources">
    <h3 class="sources-title">Where this comes from</h3>
    <p>
      <a href={dataset.url}>{dataset.name}</a> on NYC Open Data (dataset {dataset.id}).
      Source updated {date(dataset.sourceUpdatedAt)} · Last refreshed here {date(snapshot.refreshedAt)}.
    </p>
    <p>
      Looking for all city spending, not just payroll? <a href="https://www.checkbooknyc.com/">Checkbook NYC</a> covers contracts, vendors and every other kind of city spending. This page focuses on payroll.
    </p>
    <ul class="caveats">
      <li>Dollars are nominal: not adjusted for inflation.</li>
      <li>Base salary in the source data is a snapshot as of the end of each fiscal year (June 30). This page uses pay actually received during the year instead.</li>
      <li>Negative pay adjustments, such as refunds and corrections, are included in the totals.</li>
      <li>Names of NYPD and District Attorney employees are redacted in the source data, but their pay is included in these totals.</li>
    </ul>
  </footer>
</section>

<script>
  import snapshot from '../../data/payroll-by-year.json';
  import { mountWorkforceChart, missingYearsSentence } from '../../lib/workforce-chart.js';
  import { money, count, percent } from '../../lib/format.js';
  import { payrollCsvHref } from '../../lib/payroll-csv.js';

  type Year = (typeof snapshot.years)[number];
  type Agency = { id: string; label: string; years: Year[] };

  // The per-agency file is ~200 KB, so it loads only once someone picks an agency.
  // A failed load isn't cached, so picking an agency again retries it.
  let agencies: Promise<Agency[]> | null = null;
  const loadAgencies = () =>
    (agencies ??= import('../../data/payroll-by-agency.json')
      .then((m) => m.default.agencies)
      .catch((err) => {
        agencies = null;
        throw err;
      }));

  const section = document.querySelector<HTMLElement>('#workforce');
  const frame = section?.querySelector<HTMLElement>('.chart-frame');

  if (section && frame) {
    const chart = mountWorkforceChart(frame, snapshot.years);
    const select = section.querySelector<HTMLSelectElement>('#workforce-agency')!;
    const subject = section.querySelector<HTMLElement>('[data-subject]')!;
    const tbody = section.querySelector<HTMLElement>('[data-table-body]')!;
    const tableRegion = section.querySelector<HTMLElement>('.table-scroll')!;
    const totalHead = section.querySelector<HTMLElement>('[data-total-head]')!;
    const csvLink = section.querySelector<HTMLAnchorElement>('.download-link')!;
    const loadError = section.querySelector<HTMLElement>('[data-agency-error]')!;
    const cards = {
      total: section.querySelector<HTMLElement>('[data-stat="total"]')!,
      people: section.querySelector<HTMLElement>('[data-stat="people"]')!
    };
    const cityLatest = snapshot.years[snapshot.years.length - 1];

    // Keep the server-rendered citywide text so "All agencies" restores it exactly.
    const initial = {
      subject: subject.textContent,
      tableLabel: tableRegion.getAttribute('aria-label'),
      cards: Object.fromEntries(Object.entries(cards).map(([k, card]) => [k, cardText(card)]))
    };

    function cardText(card: HTMLElement) {
      return ['.stat-label', '.stat-value', '.stat-context'].map((sel) => card.querySelector(sel)!.textContent);
    }

    function setCard(card: HTMLElement, text: (string | null)[]) {
      ['.stat-label', '.stat-value', '.stat-context'].forEach((sel, i) => {
        card.querySelector(sel)!.textContent = text[i];
      });
    }

    // ---------- Pay types ----------
    const PAY_TYPES = [
      { key: 'regular', label: 'Regular pay' },
      { key: 'overtime', label: 'Overtime' },
      { key: 'other', label: 'Other pay' }
    ] as const;
    type PayKey = (typeof PAY_TYPES)[number]['key'];
    const payBoxes = Array.from(section.querySelectorAll<HTMLInputElement>('input[name="pay"]'));
    const legendItems = Array.from(section.querySelectorAll<HTMLElement>('.legend [data-pay]'));

    const selectedPay = () => payBoxes.filter((b) => b.checked).map((b) => b.value as PayKey);
    const allPay = () => selectedPay().length === PAY_TYPES.length;

    // "Overtime", "Regular pay + other pay"
    function payLabel(keys: PayKey[]) {
      return PAY_TYPES.filter((p) => keys.includes(p.key))
        .map((p, i) => (i ? p.label.toLowerCase() : p.label)).join(' + ');
    }

    function applyPayTypes() {
      const keys = selectedPay();
      // Keep at least one pay type selected
      payBoxes.forEach((b) => (b.disabled = b.checked && keys.length === 1));
      legendItems.forEach((el) => (el.hidden = !keys.includes(el.dataset.pay as PayKey)));
      // Table rows are re-rendered on agency change, so hide columns with a class
      // on the wrapper rather than on each cell.
      PAY_TYPES.forEach((p) => tableRegion.classList.toggle(`hide-${p.key}`, !keys.includes(p.key)));
      chart.setPayTypes(keys);
    }

    // ---------- Agency + pay types → stats, chart, table, CSV ----------
    let current: { years: Year[]; agency?: Agency } = { years: snapshot.years };

    // With pay types filtered, Total sums only the selected ones, matching the total card.
    function tableRows(years: Year[], keys: PayKey[]) {
      const total = (y: Year) => (allPay() ? y.total : keys.reduce((acc, k) => acc + y[k], 0));
      return years.slice().reverse().map((y) =>
        `<tr><th scope="row">FY${y.fiscalYear}</th><td data-pay="regular">${money(y.regular, 2)}</td>` +
        `<td data-pay="overtime">${money(y.overtime, 2)}</td><td data-pay="other">${money(y.other, 2)}</td>` +
        `<td>${money(total(y), 2)}</td><td>${count(y.peoplePaid)}</td></tr>`
      ).join('');
    }

    function updateTableAndCsv() {
      const { years, agency } = current;
      const keys = selectedPay();
      tbody.innerHTML = tableRows(years, keys);
      totalHead.textContent = allPay() ? 'Total' : 'Total, selected pay';
      csvLink.href = payrollCsvHref(years, keys);
      const parts = ['nyc-payroll', agency?.id, allPay() ? undefined : keys.join('-'), 'by-fiscal-year'];
      csvLink.download = `${parts.filter(Boolean).join('-')}.csv`;
    }

    function updateTotalCard() {
      const { years, agency } = current;
      const last = years[years.length - 1];
      const keys = selectedPay();

      if (allPay()) {
        if (!agency) return setCard(cards.total, initial.cards.total);
        const ended = last.fiscalYear < cityLatest.fiscalYear;
        const shareOfCity = last.total / cityLatest.total;
        return setCard(cards.total, [
          `Total payroll, FY${last.fiscalYear}`,
          money(last.total),
          ended
            ? `No payroll records after FY${last.fiscalYear}`
            : `${shareOfCity < 0.001 ? 'Less than 0.1%' : percent(shareOfCity)} of all city payroll`
        ]);
      }

      const sum = keys.reduce((acc, k) => acc + last[k], 0);
      const shareOfTotal = last.total > 0 ? sum / last.total : 0;
      setCard(cards.total, [
        `${payLabel(keys)}, FY${last.fiscalYear}`,
        money(sum),
        `${percent(shareOfTotal)} of ${agency ? `${agency.label}'s` : 'all city'} payroll`
      ]);
    }

    async function apply(id: string) {
      let agency: Agency | undefined;
      try {
        agency = id ? (await loadAgencies()).find((a) => a.id === id) : undefined;
      } catch {
        if (select.value !== id) return;
        // Go back to what's on screen (citywide or the last agency that loaded)
        // so the dropdown doesn't name an agency whose numbers aren't shown.
        select.value = current.agency?.id ?? '';
        syncUrl();
        loadError.hidden = false;
        return;
      }
      if (select.value !== id) return; // a newer choice was made while loading
      loadError.hidden = true;
      current = { years: agency?.years ?? snapshot.years, agency };

      if (!agency) {
        chart.update(snapshot.years, 'NYC payroll');
        subject.textContent = initial.subject;
        tableRegion.setAttribute('aria-label', initial.tableLabel ?? '');
        setCard(cards.people, initial.cards.people);
        updateTableAndCsv();
        updateTotalCard();
        return;
      }

      const { years, label } = agency;
      const last = years[years.length - 1];
      const range = years.length > 1 ? `FY${years[0].fiscalYear}–FY${last.fiscalYear}` : `FY${last.fiscalYear}`;

      chart.update(years, `${label} payroll`);
      subject.textContent = [`${label}, ${range}.`, missingYearsSentence(years)].filter(Boolean).join(' ');
      tableRegion.setAttribute('aria-label', `${label} payroll by fiscal year, table`);
      setCard(cards.people, [
        `People paid, FY${last.fiscalYear}`,
        count(last.peoplePaid),
        initial.cards.people[2]
      ]);
      updateTableAndCsv();
      updateTotalCard();
    }

    function syncUrl() {
      const url = new URL(location.href);
      if (select.value) url.searchParams.set('agency', select.value);
      else url.searchParams.delete('agency');
      if (allPay()) url.searchParams.delete('pay');
      else url.searchParams.set('pay', selectedPay().join(','));
      history.replaceState(null, '', url);
    }

    select.addEventListener('change', () => {
      apply(select.value);
      syncUrl();
    });

    payBoxes.forEach((box) => box.addEventListener('change', () => {
      applyPayTypes();
      updateTableAndCsv();
      updateTotalCard();
      syncUrl();
    }));

    // Shared links: ?agency=fire-department&pay=overtime. Unknown values fall back
    // to citywide / all pay types. Setting them here also resets choices the
    // browser restored on back/forward.
    const params = new URL(location.href).searchParams;
    select.value = params.get('agency') ?? '';
    const fromUrlPay = (params.get('pay') ?? '').split(',').filter((k) => PAY_TYPES.some((p) => p.key === k));
    payBoxes.forEach((b) => (b.checked = !fromUrlPay.length || fromUrlPay.includes(b.value)));
    if (!allPay()) {
      applyPayTypes();
      updateTableAndCsv();
      updateTotalCard();
    }
    if (select.value) apply(select.value);
  }
</script>

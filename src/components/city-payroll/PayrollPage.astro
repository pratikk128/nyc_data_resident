---
/*
 * Shell shared by the City Payroll Spending views: page heading plus the
 * section cards and pager. Each section is its own page (src/pages/city-payroll/)
 * so it has its own URL; the section itself goes in the default slot.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import SectionNav from '../SectionNav.astro';
import SectionPager from '../SectionPager.astro';
import payroll from '../../data/payroll-by-year.json';
import { date } from '../../lib/format.js';

// Add a section here and a page in src/pages/city-payroll/ to add a view.
const SECTIONS = [
  {
    id: 'spending',
    href: '/city-payroll/',
    label: 'How much the city spends',
    blurb: 'Total payroll each year, split into regular pay, overtime and other pay.'
  },
  {
    id: 'jobs',
    href: '/city-payroll/jobs/',
    label: 'What city jobs pay',
    blurb: 'Median salary and total pay for full-time jobs, by job title.'
  }
];

interface Props {
  section: 'spending' | 'jobs';
  description: string;
}

const { section, description } = Astro.props;
const current = SECTIONS.find((s) => s.id === section)!;
---

<DashboardLayout
  title={section === 'spending' ? 'City Payroll Spending' : `${current.label} | City Payroll Spending`}
  description={description}
  path={current.href}
  category="City Government"
  tone="blue"
  lastRefreshed={date(payroll.refreshedAt)}
  dataUpdated={payroll.dataset.sourceUpdatedAt}
>
  <header class="page-head">
    <h1>City Payroll Spending</h1>
    <p>What it costs to pay the people who run the city, in plain numbers: salaries, overtime and other pay across every agency.</p>
  </header>

  <SectionNav sections={SECTIONS} current={section} label="City Payroll Spending sections" />

  <slot />

  <SectionPager sections={SECTIONS} current={section} />
</DashboardLayout>

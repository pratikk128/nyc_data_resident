---
/*
 * The Shop Local finder, for residents: what you're looking for (category
 * tiles and a keyword), who owns it (chips), where (a ZIP, your location or a
 * borough), then result cards with Call, Website and Directions, and a
 * detail panel.
 *
 * The first view is rendered here on the server from the URL's query (see
 * src/lib/shop-local/filter.js), so shared links and the form work without
 * script. The script then fetches /api/shop-local/search for every change
 * and keeps the URL in step; a card's name opens /api/shop-local/business/:id
 * in a <dialog> and adds ?biz=<id>. "Use my location" turns the spot into the
 * nearest NYC ZIP in the browser, so only the ZIP leaves it.
 */
import { CATEGORIES, OWNERS, BOROUGHS, BASE, MAX_KEYWORD_LENGTH } from '../../lib/shop-local/config.js';
import { pageUrl } from '../../lib/shop-local/page-state.js';
import {
  cardsHtml, pagerHtml, statusText, detailHtml, iconSvg, UPSTREAM_TEXT, ZIP_ERROR, NOT_FOUND_TEXT, DETAIL_LABEL
} from '../../lib/shop-local/render.js';
import { count } from '../../lib/format.js';

interface Props {
  query: any;          // normalizeQuery() result
  initial: any;        // searchLocal() result, or null if the data couldn't load
  inputError: string | null;
  loadError: string | null; // why the first results didn't load (rate limited), else the generic message
  business: any;       // the ?biz= business's detail, { missing: true }, or null
}
const { query, initial, inputError, loadError, business } = Astro.props;

const facets = initial?.facets;
const boroLabel = BOROUGHS.find((b) => b.slug === query.boro)?.label;
const status = inputError ?? (initial ? statusText(initial, query, boroLabel) : loadError ?? UPSTREAM_TEXT);
// normalizeQuery() drops a ZIP that isn't a NYC one; keep what was typed and say so.
const rawZip = Astro.url.searchParams.get('near')?.trim() ?? '';
const zipInvalid = Boolean(rawZip) && !query.near;
const detail = business && !business.missing ? business : null;
const allCount = facets ? Object.values(facets.what as Record<string, number>).reduce((a, b) => a + b, 0) : null;
const nycCount = facets ? Object.values(facets.boroughs as Record<string, number>).reduce((a, b) => a + b, 0) : null;
const filtered = Boolean(query.what || query.own.length || query.q || query.near || query.boro || query.outside);
// Safe inside <script type="application/json">
const initialJson = JSON.stringify({ query, loaded: Boolean(initial), business: detail }).replace(/</g, '\\u003c');
---

<section class="dash-section sl-finder" aria-labelledby="sl-find-title" data-finder>
  <h2 class="sr-only" id="sl-find-title">Find a business</h2>

  <form class="sl-form" action={BASE} method="get" novalidate data-form>
    <fieldset class="sl-group">
      <legend class="sl-legend">What are you looking for?</legend>
      <div class="sl-tiles">
        <label class="sl-tile sl-tile-all">
          <input type="radio" name="what" value="" checked={!query.what} />
          <span class="sl-tile-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg>
          </span>
          <span class="sl-tile-label">Everything</span>
          <span class="sl-tile-count" data-all-count>{allCount != null ? count(allCount) : ''}</span>
        </label>
        {CATEGORIES.map((c) => (
          <label class="sl-tile" data-tone={c.tone}>
            <input type="radio" name="what" value={c.key} checked={query.what === c.key} />
            <span class="sl-tile-icon" set:html={iconSvg(c.key)}></span>
            <span class="sl-tile-label">{c.label}</span>
            <span class="sl-tile-count" data-what-count={c.key}>{facets ? count(facets.what[c.key]) : ''}</span>
          </label>
        ))}
      </div>
      <div class="field sl-keyword">
        <label class="filter-label" for="sl-q">Or search by keyword <span class="field-optional">(optional)</span></label>
        <input class="search-input" id="sl-q" name="q" type="search" maxlength={MAX_KEYWORD_LENGTH} value={query.q}
          autocomplete="off" enterkeyhint="search" placeholder="Try “braids”, “tax prep” or “jerk chicken”" data-q />
      </div>
    </fieldset>

    <fieldset class="sl-group">
      <legend class="sl-legend">Owned by <span class="field-optional">(pick any)</span></legend>
      <div class="sl-chips">
        {OWNERS.map((o) => (
          <label class="sl-chip" data-tone={o.tone}>
            <input type="checkbox" name="own" value={o.key} checked={query.own.includes(o.key)}
              disabled={Boolean(facets) && !facets.own[o.key] && !query.own.includes(o.key)} />
            {o.label} <span class="sd-count" data-own-count={o.key}>{facets ? count(facets.own[o.key]) : ''}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="sl-group">
      <legend class="sl-legend">Where</legend>
      <div class="sl-where">
        <div class="field sl-zip-field">
          <label class="filter-label" for="sl-near">Near your ZIP code</label>
          <div class="sl-zip-row">
            <input class="search-input" id="sl-near" name="near" type="text" inputmode="numeric" maxlength="5"
              value={query.near || rawZip} autocomplete="postal-code" enterkeyhint="search" placeholder="e.g. 11216"
              aria-describedby="sl-near-error sl-near-hint" aria-invalid={zipInvalid ? 'true' : undefined} data-near />
            <button type="button" class="near-btn" hidden data-locate>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>
              Use my location
            </button>
          </div>
          <p class="field-error" id="sl-near-error" data-near-error hidden={!zipInvalid}>{ZIP_ERROR}</p>
          <p class="field-error" role="alert" data-locate-error hidden></p>
          <p class="field-hint" id="sl-near-hint" data-near-hint>Nearest first. Distances are from the middle of your ZIP to the middle of theirs.</p>
        </div>
        <div class="field">
          <span class="filter-label" id="sl-boro-label">Or a borough</span>
          <div class="sl-chips" role="radiogroup" aria-labelledby="sl-boro-label">
            <label class="sl-chip sl-chip-plain">
              <input type="radio" name="boro" value="" checked={!query.boro} data-boro />
              All NYC <span class="sd-count" data-nyc-count>{nycCount != null ? count(nycCount) : ''}</span>
            </label>
            {BOROUGHS.map((b) => (
              <label class="sl-chip sl-chip-plain">
                <input type="radio" name="boro" value={b.slug} checked={query.boro === b.slug} data-boro />
                {b.label} <span class="sd-count" data-boro-count={b.slug}>{facets ? count(facets.boroughs[b.slug]) : ''}</span>
              </label>
            ))}
          </div>
        </div>
      </div>
      <label class="sd-check sl-outside" data-outside-wrap hidden={Boolean(query.boro)}>
        <input type="checkbox" name="outside" value="1" checked={query.outside} data-outside />
        Include businesses based outside NYC <span class="sd-count" data-outside-count>{facets ? count(facets.outside) : ''}</span>
      </label>
    </fieldset>

    <noscript><button type="submit" class="near-btn">Show businesses</button></noscript>
  </form>

  <div class="sl-results-head" id="sl-results-head">
    <p class="sd-status" role="status" aria-live="polite" data-status>{status}</p>
    <a class="sd-clear" href={BASE} hidden={!filtered} data-clear>Start over</a>
  </div>

  <ul class="sl-results" aria-label="Businesses" data-results
    set:html={initial ? cardsHtml(initial.results, (id: string) => pageUrl(query, { biz: id })) : ''}></ul>

  <div class="sd-empty" data-empty hidden={!initial || initial.total > 0}>
    <p class="sd-empty-title">No matches. Even the pigeons came up empty.</p>
    <p>Try another category, fewer owner choices, a nearby ZIP code or a shorter keyword.</p>
    <a class="near-btn" href={BASE} data-clear>Start over</a>
  </div>

  <nav class="pager sd-pager" aria-label="Result pages" data-pager
    set:html={initial ? pagerHtml(initial, (page: number) => pageUrl({ ...query, page })) : ''}></nav>
</section>

<dialog class="sd-detail sl-detail" aria-labelledby={detail ? 'sl-detail-title' : undefined} aria-label={detail ? undefined : DETAIL_LABEL} data-detail>
  <div class="sd-detail-bar">
    <a class="sd-close" href={pageUrl(query)} data-close>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      Close
    </a>
  </div>
  <div class="sd-detail-body" data-detail-body>
    {detail && <Fragment set:html={detailHtml(detail)} />}
    {business?.missing && <p class="sd-detail-error" role="alert">{NOT_FOUND_TEXT}</p>}
  </div>
</dialog>
{business && <noscript><style is:inline>.sd-detail { display: block; }</style></noscript>}

<script type="application/json" id="sl-initial" set:html={initialJson}></script>

<script>
  import { queryToParams, defaultQuery } from '../../lib/shop-local/filter.js';
  import { pageUrl, formQuery, zipState, startQuery, popstateAction, closeAction, nearestZip, plainClick } from '../../lib/shop-local/page-state.js';
  import { cardsHtml, skeletonCards, pagerHtml, statusText, detailHtml, UPSTREAM_TEXT, LOADING_TEXT, NOT_FOUND_TEXT, DETAIL_LABEL } from '../../lib/shop-local/render.js';
  import { BOROUGHS } from '../../lib/shop-local/config.js';
  import { inCityLimits } from '../../lib/in-city.js';
  import { count } from '../../lib/format.js';
  import zipFile from '../../data/zip-centroids.json';

  const DEBOUNCE_MS = 350;
  // Only a slow search says "Loading", so screen readers hear the count, not a message per keystroke.
  const LOADING_DELAY_MS = 1000;

  const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
  const form = $<HTMLFormElement>('[data-form]');
  const qInput = $<HTMLInputElement>('[data-q]');
  const nearInput = $<HTMLInputElement>('[data-near]');
  const nearError = $('[data-near-error]');
  const locate = $<HTMLButtonElement>('[data-locate]');
  const locateError = $('[data-locate-error]');
  const outsideWrap = $('[data-outside-wrap]');
  const status = $('[data-status]');
  const list = $<HTMLUListElement>('[data-results]');
  const empty = $('[data-empty]');
  const pager = $('[data-pager]');
  const clearTop = $<HTMLAnchorElement>('.sl-results-head [data-clear]');
  const dialog = $<HTMLDialogElement>('[data-detail]');
  const detailBody = $('[data-detail-body]');

  const initial = JSON.parse(document.getElementById('sl-initial')!.textContent || '{}');
  let query: any = initial.query;
  let searchAbort: AbortController | null = null;
  let detailAbort: AbortController | null = null;
  let current: any = null;
  let openedId: string | null = null;
  let typingTimer = 0;
  let loadingTimer = 0;
  const coarsePointer = matchMedia('(pointer: coarse)');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const bizParam = () => new URL(location.href).searchParams.get('biz');
  const boroLabel = (slug: string) => BOROUGHS.find((b) => b.slug === slug)?.label;

  // ---------- Form ↔ query ----------
  const readForm = () => formQuery(new FormData(form));

  function fillForm(q: any) {
    form.querySelectorAll<HTMLInputElement>('input[name="what"]').forEach((b) => { b.checked = b.value === q.what; });
    form.querySelectorAll<HTMLInputElement>('input[name="own"]').forEach((b) => { b.checked = q.own.includes(b.value); });
    form.querySelectorAll<HTMLInputElement>('input[name="boro"]').forEach((b) => { b.checked = b.value === q.boro; });
    $<HTMLInputElement>('[data-outside]').checked = q.outside;
    qInput.value = q.q;
    nearInput.value = q.near;
    showZipError(false);
    outsideWrap.hidden = Boolean(q.boro);
  }

  function showZipError(show: boolean) {
    nearError.hidden = !show;
    if (show) nearInput.setAttribute('aria-invalid', 'true'); else nearInput.removeAttribute('aria-invalid');
  }

  // ---------- Render ----------
  function render(data: any) {
    const f = data.facets;
    let all = 0;
    for (const [k, n] of Object.entries(f.what as Record<string, number>)) { $(`[data-what-count="${k}"]`).textContent = count(n); all += n; }
    $('[data-all-count]').textContent = count(all);
    for (const [k, n] of Object.entries(f.own as Record<string, number>)) {
      $(`[data-own-count="${k}"]`).textContent = count(n);
      // A chip with nothing to show can't be picked, unless it already is.
      const box = $<HTMLInputElement>(`input[name="own"][value="${k}"]`);
      box.disabled = !n && !box.checked;
    }
    let nyc = 0;
    for (const [k, n] of Object.entries(f.boroughs as Record<string, number>)) { $(`[data-boro-count="${k}"]`).textContent = count(n); nyc += n; }
    $('[data-nyc-count]').textContent = count(nyc);
    $('[data-outside-count]').textContent = count(f.outside);
    list.innerHTML = cardsHtml(data.results, (id: string) => pageUrl(query, { biz: id }));
    empty.hidden = data.total > 0;
    pager.innerHTML = pagerHtml(data, (page: number) => pageUrl({ ...query, page }));
    status.textContent = statusText(data, query, boroLabel(query.boro));
  }

  // An error leaves nothing from the last view.
  function clearResults() {
    list.replaceChildren();
    pager.replaceChildren();
    form.querySelectorAll('.sl-tile-count, .sd-count').forEach((el) => { el.textContent = ''; });
  }

  async function search({ push = false, scroll = false, state = null as any } = {}) {
    clearTimeout(typingTimer);
    typingTimer = 0;
    searchAbort?.abort();
    searchAbort = new AbortController();
    const defaults = pageUrl(defaultQuery());
    clearTop.hidden = pageUrl({ ...query, page: 1 }) === defaults;
    outsideWrap.hidden = Boolean(query.boro);
    const biz = bizParam();
    const url = pageUrl(query, biz ? { biz } : {});
    if (url !== location.pathname + location.search) {
      if (push) history.pushState(state, '', url); else history.replaceState(history.state, '', url);
    }
    clearTimeout(loadingTimer);
    loadingTimer = window.setTimeout(() => { status.textContent = LOADING_TEXT; }, LOADING_DELAY_MS);
    list.setAttribute('aria-busy', 'true');
    list.innerHTML = skeletonCards();
    empty.hidden = true;
    try {
      const res = await fetch(`/api/shop-local/search?${queryToParams(query)}`, { signal: searchAbort.signal });
      const data = await res.json().catch(() => null);
      clearTimeout(loadingTimer);
      if ((res.status === 400 || res.status === 429) && typeof data?.error === 'string') {
        clearResults();
        status.textContent = data.error;
        return;
      }
      if (!res.ok || !Array.isArray(data?.results)) throw new Error('upstream');
      if (data.page !== query.page) {
        query = { ...query, page: data.page };
        history.replaceState(history.state, '', pageUrl(query, biz ? { biz } : {}));
      }
      render(data);
      if (scroll) $('#sl-results-head').scrollIntoView({ block: 'start', behavior: reducedMotion.matches ? 'auto' : 'smooth' });
    } catch (err: any) {
      if (err.name === 'AbortError') return;
      clearTimeout(loadingTimer);
      clearResults();
      status.textContent = UPSTREAM_TEXT;
    } finally {
      list.removeAttribute('aria-busy');
    }
  }

  // A change: back to page 1, as a new history entry so Back undoes it. A run
  // of typing in the keyword or ZIP box is one entry ({ typing }).
  function applyForm({ typing = false } = {}) {
    const { query: q, error } = readForm();
    if (error) { status.textContent = error; return; }
    query = { ...q, page: 1 };
    search({ push: !(typing && history.state?.typing), state: typing ? { typing: true } : null });
  }

  function endTyping() {
    if (typingTimer) applyForm({ typing: true });
    if (history.state?.typing) history.replaceState(null, '', location.href);
  }

  // A ZIP and a borough don't go together: picking one clears the other.
  const setBoroAll = () => form.querySelectorAll<HTMLInputElement>('input[name="boro"]').forEach((b) => { b.checked = b.value === ''; });

  form.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target === nearInput) { showZipError(zipState(nearInput.value) === 'outside'); return endTyping(); }
    if (target === qInput) return endTyping();
    if (target.name === 'boro' && target.value) { nearInput.value = ''; showZipError(false); }
    applyForm();
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    showZipError(zipState(nearInput.value) === 'outside' || zipState(nearInput.value) === 'short');
    applyForm();
  });
  for (const input of [qInput, nearInput]) {
    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' || e.isComposing) return;
      e.preventDefault();
      form.requestSubmit();
      if (coarsePointer.matches) input.blur();
    });
    input.addEventListener('input', () => {
      if (input === nearInput) {
        const s = zipState(nearInput.value);
        if (s === 'short') return;
        showZipError(s === 'outside');
        if (s === 'outside') return;
        if (s === 'ok') setBoroAll();
      }
      clearTimeout(typingTimer);
      typingTimer = window.setTimeout(() => applyForm({ typing: true }), DEBOUNCE_MS);
    });
  }

  // ---------- Use my location ----------
  if (navigator.geolocation) locate.hidden = false;
  // Its messages go under the ZIP box, so the status line keeps the count.
  const locateDone = (message = '') => {
    locate.disabled = false;
    locate.removeAttribute('aria-busy');
    locateError.textContent = message;
    locateError.hidden = !message;
  };
  locate.addEventListener('click', () => {
    locate.disabled = true;
    locate.setAttribute('aria-busy', 'true');
    locateError.hidden = true;
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const { latitude: lat, longitude: lon } = pos.coords;
        if (!inCityLimits(lat, lon)) return locateDone('You seem to be outside NYC. Type a ZIP code instead.');
        const zip = nearestZip(lat, lon, zipFile.zips);
        if (!zip) return locateDone('We couldn’t place you in a ZIP code. Type one instead.');
        locateDone();
        nearInput.value = zip;
        showZipError(false);
        setBoroAll();
        applyForm();
      },
      () => locateDone('We couldn’t get your location. Type a ZIP code instead.'),
      { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 }
    );
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-clear]').forEach((link) => link.addEventListener('click', (e) => {
    if (!plainClick(e)) return;
    e.preventDefault();
    query = defaultQuery();
    form.reset();
    fillForm(query);
    search({ push: true });
    form.querySelector<HTMLInputElement>('input[name="what"]')!.focus();
  }));

  pager.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-page]');
    if (!link || !plainClick(e)) return;
    e.preventDefault();
    query = { ...query, page: Number(link.dataset.page) };
    search({ push: true, scroll: true });
  });

  // ---------- Detail ----------
  function nameDetail() {
    if (detailBody.querySelector('#sl-detail-title')) {
      dialog.setAttribute('aria-labelledby', 'sl-detail-title');
      dialog.removeAttribute('aria-label');
    } else {
      dialog.removeAttribute('aria-labelledby');
      dialog.setAttribute('aria-label', DETAIL_LABEL);
    }
  }

  function showDetailMessage(message: string) {
    current = null;
    detailBody.innerHTML = '<p class="sd-detail-error" role="alert"></p>';
    detailBody.querySelector('p')!.textContent = message;
    nameDetail();
  }

  async function openBusiness(id: string, { push = false } = {}) {
    detailAbort?.abort();
    detailAbort = new AbortController();
    openedId = id;
    if (push) history.pushState({ fromList: true }, '', pageUrl(query, { biz: id }));
    detailBody.setAttribute('aria-busy', 'true');
    detailBody.innerHTML = '<p class="sd-muted">Loading business details…</p><div class="sk-block"></div><div class="sk-block"></div>';
    nameDetail();
    if (!dialog.open) dialog.showModal();
    try {
      const res = await fetch(`/api/shop-local/business/${encodeURIComponent(id)}`, { signal: detailAbort.signal });
      if (res.status === 404 || res.status === 400) return showDetailMessage(NOT_FOUND_TEXT);
      const data = await res.json().catch(() => null);
      if (res.status === 429 && typeof data?.error === 'string') return showDetailMessage(data.error);
      if (!res.ok || !data) throw new Error('upstream');
      current = data;
      detailBody.innerHTML = detailHtml(data);
      nameDetail();
      $('#sl-detail-title', detailBody).focus();
    } catch (err: any) {
      if (err.name !== 'AbortError') showDetailMessage(UPSTREAM_TEXT);
    } finally {
      detailBody.setAttribute('aria-busy', 'false');
    }
  }

  list.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-id]');
    if (!link || !plainClick(e)) return;
    e.preventDefault();
    openBusiness(link.dataset.id!, { push: true });
  });

  $('[data-close]', dialog).addEventListener('click', (e) => { e.preventDefault(); dialog.close(); });
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => {
    detailAbort?.abort();
    const id = openedId;
    current = null;
    openedId = null;
    const action = closeAction(location.search, history.state);
    if (action === 'back') history.back();
    else if (action === 'replace') history.replaceState(null, '', pageUrl(query));
    if (id) list.querySelector<HTMLElement>(`a[data-id="${CSS.escape(id)}"]`)?.focus();
  });

  // ---------- Back / forward ----------
  window.addEventListener('popstate', () => {
    const action = popstateAction(location.search, { query, currentId: current?.id ?? openedId, dialogOpen: dialog.open });
    if (action.query) {
      query = action.query;
      fillForm(query);
      search();
    }
    if (action.open) openBusiness(action.open);
    else if (action.close) { current = null; dialog.close(); }
  });

  // ---------- Start ----------
  const startWith = startQuery(initial, readForm().query ?? null);
  if (startWith) {
    query = startWith;
    search();
  }
  const startBiz = bizParam();
  if (startBiz && initial.business?.id === startBiz) {
    current = initial.business;
    openedId = startBiz;
    dialog.showModal();
    $('#sl-detail-title', detailBody).focus();
  } else if (startBiz) openBusiness(startBiz);
</script>

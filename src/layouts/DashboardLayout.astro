---
/*
 * Shell for a single dashboard page: same header, palette and footer as the
 * landing page, with a breadcrumb back to the dashboard list. Page content
 * (one or more <section>s) goes in the default slot.
 */
import '../styles/landing.css';
import '../styles/dashboard.css';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ShareActions from '../components/ShareActions.astro';
import { date } from '../lib/format.js';
import { categoryHref, categoryTone } from '../data/dashboards.js';

interface Props {
  title: string;        // Dashboard name, e.g. "City Payroll Spending"
  description: string;  // Meta description
  path: string;         // e.g. "/city-payroll/"
  category?: string;    // Sidebar category on the landing page (CATEGORIES in src/data/dashboards.js); without one (a page across categories) the breadcrumb ends with the title
  lastRefreshed?: string; // Formatted date this site last pulled the data; in the footer when it isn't dataUpdated's
  dataUpdated?: string; // ISO date the source dataset was last updated; shown top right
  dataThrough?: string; // ISO date of the newest record in a snapshot; shown top right instead of dataUpdated
  reportLink?: boolean; // A dashboard that works on a spot: "See everything about this address" once it's on one (src/lib/address-report/link.js)
  share?: boolean;      // A page worth sending or keeping: "Copy link" and "Print or save as PDF" top right (ShareActions)
}

const { title, description, path, category, lastRefreshed, dataUpdated, dataThrough, reportLink, share } = Astro.props;
// The address report prints its own date and link, in its header.
const printMeta = path !== '/address/';
// Most pages read the source's own date for both; say it once, at the top.
const pulledOn = lastRefreshed && !(dataUpdated && date(dataUpdated) === lastRefreshed) ? lastRefreshed : undefined;
const fullTitle = `${title} | Ask NYC Data`;
const canonical = new URL(path, 'https://asknycdata.com').href;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta name="application-name" content="Ask NYC Data">
  <ThemeInit />
  <link rel="canonical" href={canonical}>

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Ask NYC Data">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content="https://asknycdata.com/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Ask NYC Data: NYC's public data, made easy to understand.">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <a class="brand" href="/" aria-label="Ask NYC Data, home">
      <span class="wordmark">Ask <span class="wordmark-accent">NYC</span> Data</span>
    </a>
    <p class="tagline">NYC's public data, made easy to understand.</p>
    {path !== '/address/' && (
      <a class="header-address" href="/address/" aria-label="Look up an address">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
        <span class="header-address-long" aria-hidden="true">Look up an address</span>
        <span class="header-address-short" aria-hidden="true">Address</span>
      </a>
    )}
    <ThemeToggle />
  </header>

  <main class="main dash-main" id="main" tabindex="-1">
    <div class="dash-topbar">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">All dashboards</a></li>
          {category
            ? <li><a class="tag" data-tone={categoryTone(category)} href={categoryHref(category)}>{category}</a></li>
            : <li aria-current="page">{title}</li>}
        </ol>
      </nav>
      {reportLink && (
        <p class="report-link" data-report-link hidden>
          <a href="/address/">See everything about this address <span aria-hidden="true">→</span></a>
        </p>
      )}
      {dataThrough ? (
        <p class="data-updated">Data through <time datetime={dataThrough}>{date(dataThrough)}</time></p>
      ) : dataUpdated && (
        <p class="data-updated">Data updated as of <time datetime={dataUpdated}>{date(dataUpdated)}</time></p>
      )}
      {share && <ShareActions />}
    </div>
    {printMeta && <p class="print-meta" data-print-meta></p>}

    <slot />
  </main>

  <footer class="site-footer">
    <p class="footer-brand">Ask NYC Data · <a href="https://asknycdata.com">asknycdata.com</a></p>
    <p class="footer-note">
      Built with public data from NYC Open Data. Not affiliated with or endorsed by the City of New York.
      {pulledOn && <> Ask NYC Data last pulled it on {pulledOn}.</>}
    </p>
  </footer>
  {printMeta && (
    <script>
      import { preparePrint } from '../lib/share.js';
      preparePrint();
    </script>
  )}
</body>
</html>

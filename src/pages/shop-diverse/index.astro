---
/*
 * Shop Diverse NYC: for contractors and agency buyers, find women- and
 * minority-owned businesses certified by NYC Small Business Services (by
 * code, capacity and place) and download a shortlist. Residents get a link to
 * Shop Local (/shop-local/), the resident side of the same list. Rendered on demand so a shared
 * link (?who=wbe&cat=Construction&boro=brooklyn) shows its results on first
 * paint, from the daily vendor list in KV (src/lib/server/shop-diverse.js).
 * ?biz=<account> also renders that business's detail panel and puts its
 * name in the title and link preview.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ShopDiverseFinder from '../../components/shop-diverse/ShopDiverseFinder.astro';
import AboutSection from '../../components/shop-diverse/AboutSection.astro';
import { getMetadata, getVendors, loadSearch, loadBusiness, isAccount } from '../../lib/server/shop-diverse.js';
import { RateLimited } from '../../lib/server/rate-limit.js';
import { normalizeQuery } from '../../lib/shop-diverse/filter.js';
import { businessMeta } from '../../lib/shop-diverse/render.js';
import { date } from '../../lib/format.js';

export const prerender = false;

const normalized = normalizeQuery(Astro.url.searchParams);
const query = normalized.query ?? normalizeQuery(new URLSearchParams()).query!;
const bizId = Astro.url.searchParams.get('biz');
// Shares its edge cache entry with /api/shop-diverse/business/:id.
const loadShared = async () => {
  if (!isAccount(bizId)) return null;
  return (await loadBusiness(bizId, Astro.url, Astro.locals.cfContext, Astro.clientAddress)) ?? { missing: true };
};
const [meta, initial, shared] = await Promise.allSettled([
  getMetadata(), loadSearch(query, Astro.url, Astro.locals.cfContext, Astro.clientAddress), loadShared()
]);
if (meta.status === 'rejected') console.error(meta.reason);
for (const r of [initial, shared]) if (r.status === 'rejected' && !(r.reason instanceof RateLimited)) console.error(r.reason);
// Computed by the daily job; the list is in memory once loadSearch has run.
const stored = await getVendors().catch(() => null);
const share = stored?.outsideShare ?? null;
const coverage = stored?.coverage ?? null;
const metaValue = meta.status === 'fulfilled' ? meta.value : null;
// A business detail, { missing: true }, or null (no ?biz=, or it couldn't load: the script retries)
const business = shared.status === 'fulfilled' ? shared.value : null;
const bizMeta = business && !business.missing ? businessMeta(business) : null;
const pageTitle = 'Find Certified Women- and Minority-Owned Firms';
// Production only: in dev a cached page hides edits for an hour. A page whose
// results or shared business failed to load isn't cached, so a visitor
// without script isn't stuck on the error.
if (import.meta.env.PROD && initial.status === 'fulfilled' && shared.status === 'fulfilled') {
  Astro.response.headers.set('Cache-Control', 'public, max-age=3600');
}
---

<DashboardLayout
  title={bizMeta ? `${bizMeta.title} | ${pageTitle}` : pageTitle}
  description={bizMeta?.description ??
    'Find NYC-certified women- and minority-owned firms to meet M/WBE goals: search by NAICS or NIGP code, bonding limit, past contract size and union status, and download a shortlist.'}
  path={bizMeta ? `/shop-diverse/?biz=${bizId}` : '/shop-diverse/'}
  category="Business"
  lastRefreshed={metaValue?.rowsUpdatedAt ? date(metaValue.rowsUpdatedAt) : undefined}
  dataUpdated={metaValue?.rowsUpdatedAt ?? undefined}
>
  <header class="page-head sd-head">
    <p class="sd-eyebrow">For contractors and agency buyers</p>
    <h1>{pageTitle}</h1>
    <p>
      Every women- and minority-owned business certified by NYC Small Business Services, most of them in professional
      services and construction. Find subcontractors and suppliers for your M/WBE (minority- and women-owned business
      enterprise) goals by NAICS or NIGP code, bonding limit, past contract size and union status, then download a
      shortlist.
    </p>
    <p class="sd-consumer">
      Looking for a place to eat, shop or a pro to hire? Try
      <a href="/shop-local/">women- and minority-owned businesses near you</a>.
    </p>
  </header>

  <ShopDiverseFinder
    query={query}
    initial={initial.status === 'fulfilled' ? initial.value : null}
    inputError={normalized.error ?? null}
    business={business}
  />

  <AboutSection meta={metaValue} outsideShare={share} coverage={coverage} />
</DashboardLayout>

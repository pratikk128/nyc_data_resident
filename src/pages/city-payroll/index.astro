---
/*
 * City Payroll Spending, default view: "How much does NYC spend on its
 * workforce?" "Who depends on overtime?" is overtime.astro next to this file.
 * What individual jobs pay is its own dashboard, /city-jobs/.
 */
import PayrollPage from '../../components/city-payroll/PayrollPage.astro';
import WorkforceSection from '../../components/city-payroll/WorkforceSection.astro';
import { getPayroll } from '../../lib/server/payroll.js';

// Rendered on demand from the payroll data the hourly cron keeps in KV.
export const prerender = false;

const payroll = await getPayroll();
---

<PayrollPage
  section="spending"
  description="How much NYC spends on its workforce: total payroll, overtime and other pay by fiscal year and agency, as paid and after inflation. From NYC Open Data."
  byYear={payroll.byYear}
>
  <WorkforceSection byYear={payroll.byYear} byAgency={payroll.byAgency} />
</PayrollPage>

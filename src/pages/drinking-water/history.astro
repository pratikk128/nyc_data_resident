---
/*
 * NYC Drinking Water Quality: "Has it always been this good?"
 */
import WaterPage from '../../components/drinking-water/WaterPage.astro';
import HistorySection from '../../components/drinking-water/HistorySection.astro';
import { getMetadata, getMonthly, getDetections } from '../../lib/server/water.js';

export const prerender = false;

const [meta, monthly, detections] = await Promise.allSettled([getMetadata(), getMonthly(), getDetections()]);
for (const r of [meta, monthly, detections]) if (r.status === 'rejected') console.error(r.reason);
const value = <T,>(r: PromiseSettledResult<T>) => (r.status === 'fulfilled' ? r.value : null);
---

<WaterPage
  section="history"
  description="NYC drinking water test results month by month since 2015: how often coliform and E. coli turned up, and chlorine levels in the pipes."
  meta={value(meta)}
>
  <HistorySection monthly={value(monthly)} detections={value(detections)} error={monthly.status === 'rejected'} />
</WaterPage>

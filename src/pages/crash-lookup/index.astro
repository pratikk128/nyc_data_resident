---
/*
 * NYC Crash Lookup. Rendered on demand so "Data through" comes from the
 * crash database in D1 (src/lib/server/crashes.js); searches and deep dives
 * load in the browser (src/components/crash-lookup/CrashLookup.astro).
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import CrashLookup from '../../components/crash-lookup/CrashLookup.astro';
import AboutSection from '../../components/crash-lookup/AboutSection.astro';
import { dataStatus } from '../../lib/server/crashes.js';
import { dateRange } from '../../lib/crashes/config.js';
import { date } from '../../lib/format.js';

export const prerender = false;

let status = null;
try {
  status = await dataStatus();
} catch (err) {
  console.error(err); // the page still loads; searches say the data isn't loaded
}
const through = status?.dataThrough ?? null;
const range = dateRange();

if (import.meta.env.PROD && status) Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<DashboardLayout
  title="NYC Crash Lookup"
  description="Check whether a car, bike or person you know may have been in a police-reported NYC crash in the last year. Enter what you know; see possible matches and what the report says."
  path="/crash-lookup/"
  category="Public Safety"
  lastRefreshed={status?.lastSync ? date(status.lastSync.slice(0, 10)) : status?.lastFull ? date(status.lastFull.slice(0, 10)) : undefined}
  dataUpdated={through ?? undefined}
  share
>
  <header class="page-head">
    <h1>NYC Crash Lookup</h1>
    <p>
      Think someone you know, or a car you know, was in a crash? Enter what you know, like where, when, the vehicle or the
      person, and we’ll list police-reported crashes that could be it, closest first.
    </p>
  </header>

  <div class="callout callout-heads-up cl-heads-up" role="note">
    <p><strong>Heads up.</strong> This is NYPD crash report data from NYC Open Data, {date(range.from)} to {through ? date(through) : 'the latest report'}.
    It can be incomplete or a few days behind, and it has no names or plates. A match here is a <em>possible</em> match,
    not a confirmation. To confirm one, contact the NYPD precinct or request the police report (<a href="#cl-about">how</a>).</p>
  </div>

  <CrashLookup dataThrough={through} />
  <AboutSection dataThrough={through} lastSync={status?.lastSync ?? null} />
</DashboardLayout>

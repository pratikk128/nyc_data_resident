---
/*
 * The address report: your address → drinking water, 311, street closures,
 * help, schools and restaurant grades near it, each from its own dashboard.
 * A static page: everything loads in the browser (AddressReport.astro).
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import AddressReport from '../../components/address-report/AddressReport.astro';
import { ALL } from '../../data/dashboards.js';
---

<DashboardLayout
  title="Your address report"
  description="Type an NYC address and see the drinking water, 311 requests, street closures, nearest help, nearest schools and restaurant grades around it."
  path="/address/"
  category={ALL}
>
  <header class="page-head">
    <h1>Your address report</h1>
    <p>
      One address, the city’s data around it: the water, what neighbors call 311 about, which streets are closed,
      the nearest help and schools, and how nearby restaurants did on inspection.
    </p>
  </header>

  <AddressReport />

  <section class="dash-section" aria-labelledby="ar-about-title">
    <header class="section-head">
      <h2 id="ar-about-title">Where this comes from</h2>
    </header>
    <p class="section-intro">
      Each card is a short version of one of our dashboards, using the same NYC Open Data and the same rules.
      Open a card’s link for the details, the method and the caveats.
    </p>
    <ul class="ar-sources">
      <li><strong>Drinking water:</strong> the nearest DEP sampling station, routine samples over the last 12 months.</li>
      <li><strong>311:</strong> requests within ¼ mile (about a 5-minute walk), last 12 months.</li>
      <li><strong>Street closures:</strong> DOT construction permits closing a block within ¼ mile, today and this week.</li>
      <li><strong>Help:</strong> the nearest open site of each kind within 2 miles, from seven city directories.</li>
      <li><strong>Schools:</strong> the nearest public schools by straight-line distance. Nearest isn’t the same as zoned.</li>
      <li><strong>Restaurants:</strong> up to 25 restaurants within about half a mile, nearest first, with their latest grade.</li>
    </ul>
    <p class="ar-note">
      Addresses are looked up with NYC Planning Labs’ GeoSearch. The link to a report holds only a spot rounded to
      about a block, never the address. A shared link or “Use my location” is named by the neighborhood GeoSearch
      gives for that rounded spot.
    </p>
  </section>
</DashboardLayout>

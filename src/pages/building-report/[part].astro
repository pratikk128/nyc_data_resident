---
/*
 * One part of a building's report: /building-report/repairs/?bbl=…, pests/,
 * legal/, or all/ (every section on one page). PARTS in
 * src/lib/building-report/config.js lists them. Without a ?bbl= there's no
 * building to show, so it goes back to the search.
 */
import ReportPage from '../../components/building-report/ReportPage.astro';
import { lotForPage } from '../../lib/server/building-report.js';
import { partById } from '../../lib/building-report/config.js';

export const prerender = false;

const part = Astro.params.part ?? '';
if (!partById(part) || part === 'overview') return new Response(null, { status: 404 }); // Astro serves the 404 page
if (!Astro.url.searchParams.has('bbl')) return Astro.redirect('/building-report/');

const { bbl, lot, error } = await lotForPage(Astro.url, Astro.locals.cfContext, Astro.clientAddress);
---

<ReportPage part={part} bbl={bbl} lot={lot} error={error} />

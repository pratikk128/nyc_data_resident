---
/*
 * Building Report Card: the search page, and with ?bbl= the building's
 * overview (key takeaways from every section). Each topic has its own page
 * next to this file ([part].astro). Rendered on demand (not prerendered) so
 * a shared link like ?bbl=2031070036 opens on that building with its own
 * title and description: the server looks up the lot (waiting at most
 * LOT_WAIT_MS, after which the browser loads it) and the browser then loads
 * the sections the page needs (BuildingReport.astro).
 */
import ReportPage from '../../components/building-report/ReportPage.astro';
import { lotForPage } from '../../lib/server/building-report.js';

export const prerender = false;

const { bbl, lot, error } = await lotForPage(Astro.url, Astro.locals.cfContext, Astro.clientAddress);
---

<ReportPage part="overview" bbl={bbl} lot={lot} error={error} />

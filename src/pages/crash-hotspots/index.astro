---
/*
 * NYC Crash Hotspots. Prerendered: its dates come from the static snapshot
 * `npm run data:hotspots` writes (public/data/crash-hotspots/, recorded in
 * src/data/snapshots.json), which ships with the same deploy. The numbers,
 * map and tables load in the browser from those files
 * (src/components/crash-hotspots/CrashHotspots.astro, hotspot-client.js).
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import CrashHotspots from '../../components/crash-hotspots/CrashHotspots.astro';
import AboutSection from '../../components/crash-hotspots/AboutSection.astro';
import snapshots from '../../data/snapshots.json';
import { dateRange } from '../../lib/crashes/config.js';
import { date } from '../../lib/format.js';

type Snapshot = { builtAt?: string; dataThrough?: string; dateFrom?: string };
const snapshot: Snapshot = (snapshots as Record<string, Snapshot>)['crash-hotspots'] ?? {};
const through = snapshot.dataThrough ?? null;
const from = snapshot.dateFrom ?? dateRange().from;
---

<DashboardLayout
  title="NYC Crash Hotspots"
  description="The NYC intersections where crashes hurt people most, near your home, work or school, and what goes wrong at each. For people who walk, bike or drive."
  path="/crash-hotspots/"
  category="Public Safety"
  lastRefreshed={snapshot.builtAt ? date(snapshot.builtAt.slice(0, 10)) : undefined}
  dataThrough={through ?? undefined}
  reportLink
  share
>
  <header class="page-head">
    <h1>NYC Crash Hotspots</h1>
    <p>
      Look up your street, your corner or your kid’s school. See the intersections nearby where crashes hurt people most,
      what usually goes wrong at each, and what to watch for whether you walk, bike or drive.
    </p>
  </header>

  <div class="callout callout-heads-up cl-heads-up" role="note">
    <p><strong>Heads up.</strong> These are NYPD-reported crashes from NYC Open Data, {date(from)} to {through ? date(through) : 'the latest report'}.
    Recent weeks are still filling in, counts aren’t adjusted for how busy a street is, and the tips are general safety advice
    matched to what the reports show, not findings about any one crash (<a href="#hs-about">how this works</a>).</p>
  </div>

  <CrashHotspots />
  <AboutSection dateFrom={from} dataThrough={through} builtAt={snapshot.builtAt ?? null} />
</DashboardLayout>

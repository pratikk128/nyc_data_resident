---
/*
 * NYC Crash Hotspots. Rendered on demand so "Data through" comes from the
 * crash database in D1 (src/lib/server/crashes.js); the numbers, map and
 * tables load in the browser (src/components/crash-hotspots/CrashHotspots.astro).
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import CrashHotspots from '../../components/crash-hotspots/CrashHotspots.astro';
import AboutSection from '../../components/crash-hotspots/AboutSection.astro';
import { dataStatus } from '../../lib/server/crashes.js';
import { dateRange } from '../../lib/crashes/config.js';
import { date } from '../../lib/format.js';

export const prerender = false;

let status = null;
try {
  status = await dataStatus();
} catch (err) {
  console.error(err); // the page still loads; its numbers say the data isn't loaded
}
const through = status?.dataThrough ?? null;
const range = dateRange();

if (import.meta.env.PROD && status) Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<DashboardLayout
  title="NYC Crash Hotspots"
  description="The NYC intersections where crashes hurt people most, near your home, work or school, and what goes wrong at each. For people who walk, bike or drive."
  path="/crash-hotspots/"
  category="Public Safety"
  lastRefreshed={status?.lastSync ? date(status.lastSync.slice(0, 10)) : status?.lastFull ? date(status.lastFull.slice(0, 10)) : undefined}
  dataUpdated={through ?? undefined}
  reportLink
  share
>
  <header class="page-head">
    <h1>NYC Crash Hotspots</h1>
    <p>
      Look up your street, your corner or your kid’s school. See the intersections nearby where crashes hurt people most,
      what usually goes wrong at each, and what to watch for whether you walk, bike or drive.
    </p>
  </header>

  <div class="callout callout-heads-up cl-heads-up" role="note">
    <p><strong>Heads up.</strong> These are NYPD-reported crashes from NYC Open Data, {date(range.from)} to {through ? date(through) : 'the latest report'}.
    Recent weeks are still filling in, counts aren’t adjusted for how busy a street is, and the tips are general safety advice
    matched to what the reports show, not findings about any one crash (<a href="#hs-about">how this works</a>).</p>
  </div>

  <CrashHotspots />
  <AboutSection dataThrough={through} lastSync={status?.lastSync ?? null} />
</DashboardLayout>

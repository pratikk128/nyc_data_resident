---
import '../styles/landing.css';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { dashboards, ALL, AUDIENCES, CATEGORIES, categorySlug, categoryHref, categoryTone, categoryIcon } from '../data/dashboards.js';

// Cards and the sidebar are rendered here; public/js/app.js only filters them.
// Counts start at the default audience; app.js recounts when it changes.
const DEFAULT_AUDIENCE = AUDIENCES[0].id;
const forDefault = dashboards.filter((d) => d.audience.includes(DEFAULT_AUDIENCE));
const countFor = (name: string) =>
  name === ALL ? forDefault.length : forDefault.filter((d) => d.category === name).length;
const plural = (n: number) => `${n} ${n === 1 ? 'dashboard' : 'dashboards'}`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ask NYC Data | Interactive Dashboards for NYC Residents</title>
  <meta name="description" content="Explore interactive dashboards and visualizations on NYC restaurant inspections, 311 complaints, city spending, and more, built on public NYC Open Data.">
  <meta name="application-name" content="Ask NYC Data">
  <ThemeInit />
  <link rel="canonical" href="https://asknycdata.com/">

  <!-- Open Graph / social -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Ask NYC Data">
  <meta property="og:title" content="Ask NYC Data | Interactive Dashboards for NYC Residents">
  <meta property="og:description" content="Explore interactive dashboards and visualizations on NYC restaurant inspections, 311 complaints, city spending, and more, built on public NYC Open Data.">
  <meta property="og:url" content="https://asknycdata.com/">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="Ask NYC Data">
  <meta name="twitter:description" content="NYC's public data, made easy to understand.">

  <!-- Favicon: map pin on a pastel blue tile -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Apply the saved sidebar state before first paint to avoid a flash -->
  <script is:inline>
    try {
      if (localStorage.getItem("anycd-sidebar") === "collapsed") {
        document.documentElement.classList.add("sidebar-collapsed");
      }
    } catch (e) {}
  </script>
</head>
<body class="has-audience">
  <a class="skip-link" href="#main">Skip to dashboards</a>

  <header class="site-header">
    <button class="menu-toggle" id="menu-toggle" type="button"
            aria-controls="sidebar" aria-expanded="true" aria-label="Hide categories">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <a class="brand" href="/" aria-label="Ask NYC Data, home">
      <span class="wordmark">Ask <span class="wordmark-accent">NYC</span> Data</span>
    </a>
    <p class="tagline">NYC's public data, made easy to understand.</p>
    <div class="audience-toggle" id="audience-toggle" role="group" aria-label="Show dashboards">
      {AUDIENCES.map(({ id, label, short, icon }, i) => (
        <button class="audience-btn" type="button" data-audience={id} aria-pressed={i === 0 ? 'true' : 'false'}>
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
          <span class="audience-label">{label}</span>
          <span class="audience-short" aria-hidden="true">{short}</span>
        </button>
      ))}
    </div>
    <ThemeToggle />
  </header>

  <div class="layout">
    <aside class="sidebar" id="sidebar" aria-label="Dashboard categories">
      <nav class="sidebar-nav" aria-labelledby="sidebar-title">
        <h2 class="sidebar-title" id="sidebar-title">Categories</h2>
        <ul class="category-list" id="category-list">
          {CATEGORIES.map(({ name, tone, icon }) => {
            const n = countFor(name);
            return (
              <li>
                <a class="category-btn" href={categoryHref(name)} data-category={name === ALL ? '' : categorySlug(name)}
                   data-tone={tone} title={name} aria-label={`${name}, ${plural(n)}`}
                   aria-current={name === ALL ? 'page' : undefined}>
                  <svg class="category-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
                  <span class="category-label">{name}</span>
                  <span class="category-count" aria-hidden="true">{n}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </aside>
    <div class="backdrop" id="backdrop" hidden></div>

    <main class="main" id="main" tabindex="-1">
      <section class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title">Everything NYC has been up to, in one place.</h1>
        <p>Clear answers about your neighborhood, straight from official NYC records.</p>
      </section>

      <section class="results" aria-labelledby="results-title">
        <div class="results-head">
          <h2 id="results-title">{ALL}</h2>
          <p class="results-count" id="results-count" aria-live="polite">{plural(forDefault.length)}</p>
        </div>
        <ul class="card-grid" id="card-grid" hidden={forDefault.length === 0}>
          {dashboards.map((d) => (
            <li data-category={categorySlug(d.category)} data-audience={d.audience.join(' ')}
              hidden={!d.audience.includes(DEFAULT_AUDIENCE)}>
              <a class="card" data-tone={categoryTone(d.category)} href={d.url || '#'}>
                <span class="card-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={categoryIcon(d.category)} /></span>
                <h3 class="card-title">{d.title}</h3>
                <p class="card-desc">{d.description}</p>
                <span class="card-footer">
                  <span class="tag">{d.category}</span>
                  <span class="card-link">Open dashboard <span aria-hidden="true">→</span></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <div class="empty-state" id="empty-state" hidden={forDefault.length !== 0}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"/></svg>
          <p id="empty-text">No dashboards in this category yet. Coming soon.</p>
        </div>
      </section>
    </main>
  </div>

  <footer class="site-footer">
    <p class="footer-brand">Ask NYC Data · <a href="https://asknycdata.com">asknycdata.com</a></p>
    <p class="footer-note">Data sourced from NYC Open Data. Not affiliated with the City of New York.</p>
  </footer>

  <!-- Plain script served from public/js; edit src/data/dashboards.js to add dashboards -->
  <script is:inline src="/js/app.js"></script>
</body>
</html>

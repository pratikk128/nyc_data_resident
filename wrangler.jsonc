// Cloudflare Workers config. Static pages are served from ./dist as assets;
// API routes and on-demand pages run in src/worker.js.
// Secrets (not in this file): `npx wrangler secret put SOCRATA_APP_TOKEN`.
// Local dev reads them from .dev.vars (see .dev.vars.example).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asknycdata",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Aggregates for every dataset and the ETL's state (src/lib/server/etl.js),
  // written by the scheduled refresh outside the Worker (scripts/run-etl.mjs,
  // .github/workflows/etl.yml); requests only read them. No cron trigger: a
  // refresh needs more CPU and subrequests than the free plan gives a Worker.
  // No "id": wrangler creates the namespace on first deploy.
  "kv_namespaces": [{ "binding": "DATA_CACHE" }],

  // NYC Crash Hotspots' crash, vehicle and person tables (src/lib/server/crashes.js).
  // Loaded by `npm run data:crashes` + `npm run data:crashes:push -- --local|--remote`;
  // the scheduled refresh (scripts/run-etl.mjs) keeps recent weeks current. Only the
  // refresh reads it: requests read what it built into KV (src/lib/server/crash-hotspots.js),
  // so page views use none of D1's daily row reads. No "database_id": wrangler
  // creates the database on first deploy (push --remote after that).
  "d1_databases": [{ "binding": "CRASHES_DB", "database_name": "asknycdata-crashes" }],

  // Per-client limits on searches, restaurant lookups and 311 areas that miss the cache
  // (src/lib/server/rate-limit.js). namespace_id is any number unique to each
  // limiter within the account.
  "ratelimits": [
    { "name": "SEARCH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "DETAIL_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    // 311 areas: each uncached lookup is 4–5 Socrata queries
    { "name": "AREA_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    // School Quality search: KV only, runs as you type, and the map view asks
    // twice, plus classrooms and libraries share one IP.
    { "name": "SCHOOL_SEARCH_RATE_LIMITER", "namespace_id": "1006", "simple": { "limit": 120, "period": 60 } },
    // Street closures: KV only, but one search per place change and per radius
    { "name": "CLOSURES_RATE_LIMITER", "namespace_id": "1007", "simple": { "limit": 60, "period": 60 } },
    // Help near me: KV only, one search per spot (radius and categories switch in the browser)
    { "name": "HELP_RATE_LIMITER", "namespace_id": "1008", "simple": { "limit": 60, "period": 60 } },
    // Building Report Card: live Socrata; one lot lookup and eight sections per building viewed
    { "name": "BUILDING_RATE_LIMITER", "namespace_id": "1011", "simple": { "limit": 90, "period": 60 } },
    // Park amenities: KV only, one search per spot (radius and categories switch in the browser)
    { "name": "PARKS_RATE_LIMITER", "namespace_id": "1012", "simple": { "limit": 60, "period": 60 } }
  ],

  // The deploy's version id, part of the Street Closures, Help Near Me and Park Amenities edge cache keys
  // (src/lib/server/street-closures.js, help-near-me.js, park-amenities.js) so a deploy's changes show at once.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "observability": { "enabled": true }
}

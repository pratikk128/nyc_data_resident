# Static files (served without the Worker). Keep in sync with src/middleware.js.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

# NYC Crash Hotspots' snapshot (npm run data:hotspots). The page asks for
# each file with ?v=<a hash of the files> (src/lib/crashes/hotspot-client.js),
# so a deploy with a new snapshot is a new URL and these can be kept a year.
/data/crash-hotspots/*
  Cache-Control: public, max-age=31536000, immutable
